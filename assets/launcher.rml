<rml>
	<head>
		<title>Launcher</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="recomp.rcss"/>
		<style>
			body
			{
				width: 100%;
				height: 100%;
			}
			.launcher__prepare
			{
				display: block;
				width: 520dp;
				margin: 8dp 0dp 24dp 0dp;
				text-align: right;
				font-size: 22dp;
				color: rgba(255, 255, 255, 220);
			}
			.launcher__prepare-text
			{
				display: block;
			}
			.launcher__prepare-bar
			{
				display: block;
				height: 14dp;
				margin: 10dp 0dp 10dp 0dp;
				border-width: 2dp;
				border-color: rgba(255, 255, 255, 160);
				border-radius: 7dp;
				background-color: rgba(0, 0, 0, 120);
			}
			.launcher__prepare-fill
			{
				display: block;
				height: 100%;
				border-radius: 5dp;
				background-color: rgba(120, 200, 255, 255);
			}
			.launcher__prepare-note
			{
				display: block;
				font-size: 18dp;
				color: rgba(255, 255, 255, 160);
			}
		</style>
	</head>
	<body>
		<div id="window" data-model="launcher_model">
			<div class="launcher">
				<div class="launcher__vertical-split">
					<div class="launcher__title-quadrant">
						<button class="subtitle-title" disabled>
							<div><h3>Recompiled</h3></div>
							<div><h1>Magical Blocks</h1></div>
							<div class="subtitle-title__disclaimer">Unofficial fan project. Requires your own USA (NMTE) ROM.</div>
						</button>
					</div>
					<div class="launcher__content-quadrant"></div>
				</div>
				<div class="launcher__vertical-split launcher__vertical-split--right">
					<div class="launcher__title-quadrant launcher__title-quadrant--right">
						<button class="subtitle-title subtitle-title--right" selected>
							<div><h3>Status</h3></div>
							<div data-if="!mtc_rom_valid"><h1>ROM needed</h1></div>
							<div data-if="mtc_rom_valid &amp;&amp; mtc_code_state == 3"><h1>Ready</h1></div>
							<div data-if="mtc_rom_valid &amp;&amp; (mtc_code_state == 1 || mtc_code_state == 2)"><h1>Preparing...</h1></div>
							<div data-if="mtc_rom_valid &amp;&amp; mtc_code_state == 4"><h1>Not ready</h1></div>
						</button>
					</div>
					<div class="launcher__content-quadrant">
						<button data-if="!mtc_rom_valid" onclick="select_rom" class="menu-list-item menu-list-item--right" autofocus>
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Select ROM</div>
						</button>
						<button data-if="mtc_rom_valid &amp;&amp; mtc_code_state == 3" onclick="start_game" class="menu-list-item menu-list-item--right" autofocus>
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Start game</div>
						</button>
						<!-- First launch: the game is built from the player's own ROM (OPTB.md). -->
						<div data-if="mtc_rom_valid &amp;&amp; (mtc_code_state == 1 || mtc_code_state == 2)" class="launcher__prepare">
							<div class="launcher__prepare-text">{{mtc_code_message}} {{mtc_code_percent}}%</div>
							<div class="launcher__prepare-bar"><div class="launcher__prepare-fill" data-style-width="mtc_code_percent + '%'"></div></div>
							<div class="launcher__prepare-note">This happens only once and takes a few seconds (up to a minute on slower PCs).</div>
						</div>
						<div data-if="mtc_rom_valid &amp;&amp; mtc_code_state == 4" class="launcher__prepare">
							<div class="launcher__prepare-text">{{mtc_code_message}}</div>
						</div>
						<button data-if="mtc_rom_valid &amp;&amp; mtc_code_state == 4" onclick="retry_prepare" class="menu-list-item menu-list-item--right" autofocus>
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Try again</div>
						</button>
						<button onclick="open_controls" class="menu-list-item menu-list-item--right">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Setup controls</div>
						</button>
						<button onclick="open_settings" class="menu-list-item menu-list-item--right">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Settings</div>
						</button>
						<button onclick="open_mods" class="menu-list-item menu-list-item--right">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Mods</div>
						</button>
						<button data-if="mtc_rom_valid" onclick="select_rom" class="menu-list-item menu-list-item--right">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Change ROM</div>
						</button>
						<button onclick="exit_game" class="menu-list-item menu-list-item--right">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Exit</div>
						</button>
					</div>
				</div>
				<div class="bottom-left">
					<label>v{{version_number}}</label>
				</div>
			</div>
		</div>
	</body>
</rml>
