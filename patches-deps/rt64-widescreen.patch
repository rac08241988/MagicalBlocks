@@ -0,0 +1,92 @@
+//
+// RT64 widescreen borders: draw an app-provided RGBA canvas around the 4:3 game image (pillarbox art).
+// SPDX-License-Identifier: MIT
+//
+// The canvas is canvasWidth x canvasHeight pixels whose center gameWidth columns line up with the game
+// image; it is scaled so its height matches the game's and centered on it. Only the parts outside the
+// game are visible. Pixels are decoded by the application (e.g. from the user's ROM); RT64 never ships
+// any art.
+//
+// Shader scope (when a post-processing preset is active):
+// - GameOnly (default): the preset runs on the game image only; the borders are drawn unprocessed.
+// - GameAndBorders: game + borders are composed into one image first and the preset runs on all of it.
+//
+// Thread model: the setters may be called from any thread. The present thread uploads a new canvas at
+// the start of its next frame.
+//
+
+#pragma once
+
+#include <memory>
+#include <mutex>
+#include <vector>
+
+#include "rhi/rt64_render_interface.h"
+#include "rt64_vi_renderer.h"
+
+namespace RT64 {
+    struct WidescreenBorders {
+        enum class ShaderScope {
+            GameOnly = 0,
+            GameAndBorders = 1
+        };
+
+        // Window-space layout for one frame.
+        struct Plan {
+            bool active = false;
+            RenderViewport gameViewport;
+            RenderRect gameScissor;
+            RenderViewport canvasViewport; // where the whole canvas lands (may extend past the window)
+            RenderRect canvasScissor;      // canvas clipped to the window
+        };
+
+        WidescreenBorders();
+        ~WidescreenBorders();
+
+        // Any thread.
+        void setEnabled(bool enabled);
+        bool isEnabled() const;
+        // Copies the pixels. rgba == nullptr (or a zero size) clears the canvas.
+        bool setCanvas(const uint8_t *rgba, uint32_t width, uint32_t height, uint32_t gameWidth);
+        void setShaderScope(ShaderScope scope);
+        ShaderScope getShaderScope() const;
+        void setLinearFiltering(bool linear);
+
+        // Present thread.
+        void beginFrame(RenderDevice *device, RenderCommandList *commandList);
+        Plan plan(const VIRenderer::RenderParams &game) const;
+        // Draws the canvas with the VI shader into the current framebuffer.
+        void drawCanvas(const VIRenderer::RenderParams &game, const RenderViewport &viewport, const RenderRect &scissor);
+        // Offscreen target for the GameAndBorders scope (B8G8R8A8, the format of the VI pipelines).
+        bool ensureComposeTarget(RenderDevice *device, uint32_t width, uint32_t height);
+
+        RenderTexture *composeTexture() const { return compose.get(); }
+        RenderFramebuffer *composeFramebuffer() const { return composeFb.get(); }
+        uint32_t composeWidth() const { return composeW; }
+        uint32_t composeHeight() const { return composeH; }
+
+        // Separate VI renderers so each draw in a frame has its own descriptor set.
+        VIRenderer canvasRenderer;
+        VIRenderer composedGameRenderer;
+        VIRenderer finalRenderer;
+
+    private:
+        mutable std::mutex mutex;
+        bool enabled = false;
+        ShaderScope scope = ShaderScope::GameOnly;
+        bool linear = false;
+        bool pendingCanvas = false;
+        std::vector<uint8_t> pendingPixels;
+        uint32_t pendingWidth = 0, pendingHeight = 0, pendingGameWidth = 0;
+
+        // Present thread only.
+        std::unique_ptr<RenderTexture> canvas;
+        std::unique_ptr<RenderBuffer> canvasUpload;
+        uint32_t canvasW = 0, canvasH = 0, canvasGameW = 0;
+        bool frameEnabled = false;
+        bool frameLinear = false;
+        std::unique_ptr<RenderTexture> compose;
+        std::unique_ptr<RenderFramebuffer> composeFb;
+        uint32_t composeW = 0, composeH = 0;
+    };
+};
