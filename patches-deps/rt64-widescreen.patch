+//
+// RT64 widescreen borders.
+// SPDX-License-Identifier: MIT
+//
+
+#include "rt64_widescreen_borders.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+namespace RT64 {
+    static const uint32_t UploadPitchAlignment = 256;
+
+    WidescreenBorders::WidescreenBorders() { }
+
+    WidescreenBorders::~WidescreenBorders() { }
+
+    void WidescreenBorders::setEnabled(bool enabled) {
+        std::lock_guard<std::mutex> lock(mutex);
+        this->enabled = enabled;
+    }
+
+    bool WidescreenBorders::isEnabled() const {
+        std::lock_guard<std::mutex> lock(mutex);
+        return enabled;
+    }
+
+    bool WidescreenBorders::setCanvas(const uint8_t *rgba, uint32_t width, uint32_t height, uint32_t gameWidth) {
+        const bool clear = (rgba == nullptr) || (width == 0) || (height == 0);
+        if (!clear && ((gameWidth == 0) || (gameWidth > width) || (width > 8192) || (height > 8192))) {
+            return false;
+        }
+
+        std::lock_guard<std::mutex> lock(mutex);
+        if (clear) {
+            pendingPixels.clear();
+            pendingWidth = pendingHeight = pendingGameWidth = 0;
+        }
+        else {
+            pendingPixels.assign(rgba, rgba + size_t(width) * height * 4);
+            pendingWidth = width;
+            pendingHeight = height;
+            pendingGameWidth = gameWidth;
+        }
+
+        pendingCanvas = true;
+        return true;
+    }
+
+    void WidescreenBorders::setShaderScope(ShaderScope scope) {
+        std::lock_guard<std::mutex> lock(mutex);
+        this->scope = scope;
+    }
+
+    WidescreenBorders::ShaderScope WidescreenBorders::getShaderScope() const {
+        std::lock_guard<std::mutex> lock(mutex);
+        return scope;
+    }
+
+    void WidescreenBorders::setLinearFiltering(bool linear) {
+        std::lock_guard<std::mutex> lock(mutex);
+        this->linear = linear;
+    }
+
+    void WidescreenBorders::beginFrame(RenderDevice *device, RenderCommandList *commandList) {
+        std::vector<uint8_t> pixels;
+        uint32_t w = 0, h = 0, gw = 0;
+        bool upload = false;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            frameEnabled = enabled;
+            frameLinear = linear;
+            if (pendingCanvas) {
+                pixels.swap(pendingPixels);
+                w = pendingWidth;
+                h = pendingHeight;
+                gw = pendingGameWidth;
+                pendingCanvas = false;
+                upload = true;
+            }
+        }
+
+        if (!upload) {
+            // The previous frame's copy has completed (the present thread waits for the GPU every frame).
+            canvasUpload.reset();
+            return;
+        }
+
+        // Safe to release the old texture: the GPU finished the previous frame.
+        canvas.reset();
+        canvasUpload.reset();
+        canvasW = canvasH = canvasGameW = 0;
+        if (pixels.empty()) {
+            return;
+        }
+
+        const uint32_t rowPitch = w * 4;
+        const uint32_t alignedRowPitch = (rowPitch + UploadPitchAlignment - 1) / UploadPitchAlignment * UploadPitchAlignment;
+        canvas = device->createTexture(RenderTextureDesc::Texture2D(w, h, 1, RenderFormat::R8G8B8A8_UNORM));
+        canvasUpload = device->createBuffer(RenderBufferDesc::UploadBuffer(uint64_t(alignedRowPitch) * h));
+        uint8_t *dst = (canvasUpload != nullptr) ? reinterpret_cast<uint8_t *>(canvasUpload->map()) : nullptr;
+        if ((canvas == nullptr) || (dst == nullptr)) {
+            canvas.reset();
+            canvasUpload.reset();
+            return;
+        }
+
+        for (uint32_t y = 0; y < h; y++) {
+            memcpy(dst + size_t(y) * alignedRowPitch, pixels.data() + size_t(y) * rowPitch, rowPitch);
+        }
+
+        canvasUpload->unmap();
+        commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(canvas.get(), RenderTextureLayout::COPY_DEST));
+        commandList->copyTextureRegion(RenderTextureCopyLocation::Subresource(canvas.get()),
+            RenderTextureCopyLocation::PlacedFootprint(canvasUpload.get(), RenderFormat::R8G8B8A8_UNORM, w, h, 1, alignedRowPitch / 4));
+        commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(canvas.get(), RenderTextureLayout::SHADER_READ));
+        canvasW = w;
+        canvasH = h;
+        canvasGameW = gw;
+    }
+
+    WidescreenBorders::Plan WidescreenBorders::plan(const VIRenderer::RenderParams &game) const {
+        Plan p;
+        if (!frameEnabled || (canvas == nullptr) || (game.swapChain == nullptr) || (game.vi == nullptr)) {
+            return p;
+        }
+
+        hlslpp::float2 fbHdRegion;
+        VIRenderer::getViewportAndScissor(game.swapChain, *game.vi, game.resolutionScale, game.downsamplingScale, p.gameViewport, p.gameScissor, fbHdRegion);
+        if ((p.gameViewport.width <= 0.0f) || (p.gameViewport.height <= 0.0f)) {
+            return p;
+        }
+
+        // Canvas rows map onto the game viewport's rows and its center gameWidth columns onto the viewport's width.
+        const float sx = p.gameViewport.width / float(canvasGameW);
+        const float sy = p.gameViewport.height / float(canvasH);
+        const float w = float(canvasW) * sx;
+        const float cx = p.gameViewport.x + p.gameViewport.width * 0.5f;
+        p.canvasViewport = RenderViewport(cx - w * 0.5f, p.gameViewport.y, w, float(canvasH) * sy);
+
+        const int32_t windowW = int32_t(game.swapChain->getWidth());
+        const int32_t windowH = int32_t(game.swapChain->getHeight());
+        p.canvasScissor = RenderRect(
+            std::max<int32_t>(0, int32_t(std::floor(p.canvasViewport.x))),
+            std::max<int32_t>(0, int32_t(std::floor(p.canvasViewport.y))),
+            std::min<int32_t>(windowW, int32_t(std::ceil(p.canvasViewport.x + p.canvasViewport.width))),
+            std::min<int32_t>(windowH, int32_t(std::ceil(p.canvasViewport.y + p.canvasViewport.height))));
+
+        // Nothing to show when the window isn't wider than the game.
+        p.active = (p.canvasScissor.left < int32_t(std::floor(p.gameViewport.x))) || (p.canvasScissor.right > int32_t(std::ceil(p.gameViewport.x + p.gameViewport.width)));
+        return p;
+    }
+
+    void WidescreenBorders::drawCanvas(const VIRenderer::RenderParams &game, const RenderViewport &viewport, const RenderRect &scissor) {
+        VIRenderer::RenderParams p = game;
+        p.texture = canvas.get();
+        p.textureFormat = RenderFormat::R8G8B8A8_UNORM;
+        p.textureWidth = canvasW;
+        p.textureHeight = canvasH;
+        p.textureIsVideoRegion = true;
+        p.filtering = frameLinear ? UserConfiguration::Filtering::Linear : UserConfiguration::Filtering::Nearest;
+        p.useViewportOverride = true;
+        p.viewportOverride = viewport;
+        p.scissorOverride = scissor;
+        canvasRenderer.render(p);
+    }
+
+    bool WidescreenBorders::ensureComposeTarget(RenderDevice *device, uint32_t width, uint32_t height) {
+        if ((compose != nullptr) && (composeW == width) && (composeH == height)) {
+            return true;
+        }
+
+        composeFb.reset();
+        compose = device->createTexture(RenderTextureDesc::ColorTarget(width, height, RenderFormat::B8G8R8A8_UNORM));
+        if (compose == nullptr) {
+            composeW = composeH = 0;
+            return false;
+        }
+
+        const RenderTexture *target = compose.get();
+        composeFb = device->createFramebuffer(RenderFramebufferDesc(&target, 1));
+        composeW = width;
+        composeH = height;
+        return composeFb != nullptr;
+    }
+};
