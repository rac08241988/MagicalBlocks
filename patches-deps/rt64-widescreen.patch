+                bool presentedComposite = false;
 #           if RT64_POSTPROCESS
+                // [magical-tetris widescreen] "Game and borders" shader scope: compose both into one image at
+                // the game's internal resolution, run the preset on it, then present the result.
+                if (bordersPlan.active && (ext.postProcess != nullptr) && ext.postProcess->isEnabled() &&
