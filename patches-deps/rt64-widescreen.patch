diff --git a/src/hle/rt64_present_queue.cpp b/src/hle/rt64_present_queue.cpp
index 3951cf6..0c32566 100644
--- a/src/hle/rt64_present_queue.cpp
+++ b/src/hle/rt64_present_queue.cpp
@@ -337,10 +337,89 @@ namespace RT64 {
                     }
                 }
                 
+                // [magical-tetris widescreen] Pillarbox border art around the game image.
+                WidescreenBorders::Plan bordersPlan;
+                if ((ext.widescreenBorders != nullptr) && (renderParams.texture != nullptr) && (renderParams.vi != nullptr)) {
+                    ext.widescreenBorders->beginFrame(ext.device, commandList);
+                    bordersPlan = ext.widescreenBorders->plan(renderParams);
+                }
