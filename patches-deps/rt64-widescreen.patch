From b2c88bd971be88af103613557858569b12ad4702 Mon Sep 17 00:00:00 2001
From: n64recomp-shaders <n64recomp-shaders@localhost>
Date: Sun, 18 Oct 2026 02:43:04 -0400
Subject: [PATCH 1/2] S2DEX BG_COPY: fix TMEM line stride for 4/8-bit images
 and slice by whole rows

The TMEM line stride was computed as imageW >> (2 + siz), which is only
correct for 16/32-bit images. For CI8 backgrounds it was 4x too large,
so each multi-row LoadTile overflowed into the upper half of TMEM and
overwrote the TLUT, producing garbled blocks (Magical Tetris Challenge
title screen). Also stop halving tmemH for CI images (guS2DInitBg already
accounts for it), which produced fractional 2.5-row slices, and draw the
remaining rows of the last slice.
---
 src/gbi/rt64_gbi_s2dex.cpp | 42 +++++++++++++++++++++++++-------------
 1 file changed, 28 insertions(+), 14 deletions(-)

diff --git a/src/gbi/rt64_gbi_s2dex.cpp b/src/gbi/rt64_gbi_s2dex.cpp
index 896334a..76c4656 100644
--- a/src/gbi/rt64_gbi_s2dex.cpp
+++ b/src/gbi/rt64_gbi_s2dex.cpp
@@ -4,6 +4,8 @@
 
 #include "rt64_gbi_s2dex.h"
 
+#include <algorithm>
+
 #include "../include/rt64_extended_gbi.h"
 
 #include "rt64_gbi_extended.h"
@@ -447,8 +449,13 @@ namespace RT64 {
             assert(bg.imageLoad == S2DEX_G_BGLT_LOADTILE); // TODO: Only the load tile version is implemented.
             
             const uint16_t TMEMAddress = 0;
-            const uint8_t lineShiftOffset = (bg.imageSiz == G_IM_SIZ_32b) ? 1 : 0;
-            const uint16_t bgLine = bg.imageW >> (2 + bg.imageSiz - lineShiftOffset);
+            // TMEM line stride in 64-bit words for one image row. 32-bit images are split across both TMEM halves,
+            // so they use the same stride as a 16-bit image. The previous formula (imageW >> (2 + siz)) was only
+            // correct for 16/32-bit images: for 8-bit and 4-bit images it produced a stride 4x/16x too large, so
+            // multi-row loads overflowed into the upper half of TMEM and corrupted the TLUT of CI backgrounds.
+            const uint32_t lineSiz = (bg.imageSiz == G_IM_SIZ_32b) ? G_IM_SIZ_16b : bg.imageSiz;
+            const uint32_t bgRowBytes = (uint32_t(bg.imageW >> 2) << lineSiz) >> 1;
+            const uint16_t bgLine = uint16_t((bgRowBytes + 7) >> 3);
             const uint16_t dsdx = 4 << 10;
             const uint16_t dsdy = 4 << 8;
             const uint16_t lrSubstract = 4;
@@ -478,23 +485,30 @@ namespace RT64 {
                 }
             }
 
-            const uint32_t Division = (bg.imageFmt == G_IM_FMT_CI) ? 2 : 1;
-            const uint16_t sliceH = uint16_t(bg.tmemH / Division);
+            // Draw the image in horizontal slices of whole rows that fit in TMEM. tmemH (u10.2) as computed by
+            // guS2DInitBg already accounts for CI images only having the lower half of TMEM available, so it must not
+            // be halved again (that produced fractional 2.5-row slices with gaps). Clamp it to what actually fits.
+            const uint32_t tmemWords = (bg.imageFmt == G_IM_FMT_CI) ? (RDP_TMEM_WORDS / 2) : RDP_TMEM_WORDS;
+            const uint32_t maxRows = (bgLine > 0) ? (tmemWords / bgLine) : 0;
+            uint32_t sliceRows = bg.tmemH >> 2;
+            if ((sliceRows == 0) || (sliceRows > maxRows)) {
+                sliceRows = maxRows;
+            }
 
-            // Divide-by-zero guard: a TMEM height below one line can't be drawn.
-            if (sliceH < lrSubstract) {
+            // Guard: an image row that doesn't fit in TMEM can't be drawn.
+            if (sliceRows == 0) {
                 state->endSpriteCommand();
                 return;
             }
 
-            const uint16_t bgRectCount = bg.imageH / sliceH; // TODO: Check for remaining pixels for the last Texrect.
-            bgRectLrt = sliceH - lrSubstract;
-            rdp->setTileSize(G_TX_RENDERTILE, 0, 0, bgRectLrs, bgRectLrt);
-
-            for (uint16_t r = 0; r < bgRectCount; r++) {
-                const uint16_t bgRectUlt = r * (bg.tmemH / Division);
-                rdp->loadTile(G_TX_LOADTILE, 0, bgRectUlt, bgRectLrs, bgRectUlt + bgRectLrt);
-                rdp->drawTexRect(bg.frameX, bg.frameY + bgRectUlt, bg.frameX + bg.frameW - lrSubstract, bg.frameY + bgRectUlt + bgRectLrt, G_TX_RENDERTILE, 0, 0, dsdx, dsdy, false);
+            const uint32_t imageRows = bg.imageH >> 2;
+            for (uint32_t row = 0; row < imageRows; row += sliceRows) {
+                const uint32_t rows = std::min(sliceRows, imageRows - row);
+                const uint16_t ult = uint16_t(row << 2);
+                const uint16_t lrt = uint16_t((row + rows - 1) << 2);
+                rdp->setTileSize(G_TX_RENDERTILE, 0, 0, bgRectLrs, uint16_t((rows - 1) << 2));
+                rdp->loadTile(G_TX_LOADTILE, 0, ult, bgRectLrs, lrt);
+                rdp->drawTexRect(bg.frameX, bg.frameY + ult, bg.frameX + bg.frameW - lrSubstract, bg.frameY + lrt, G_TX_RENDERTILE, 0, 0, dsdx, dsdy, false);
             }
 
             state->endSpriteCommand();
-- 
