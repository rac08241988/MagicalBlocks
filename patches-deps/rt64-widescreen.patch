+++ b/src/render/rt64_widescreen_api.cpp
@@ -0,0 +1,50 @@
+//
+// RT64 widescreen borders: C API.
+// SPDX-License-Identifier: MIT
+//
+
+#include "rt64_widescreen_api.h"
+
+#include "hle/rt64_application.h"
+
+namespace {
+    RT64::WidescreenBorders *getBorders(void *app) {
+        return (app != nullptr) ? static_cast<RT64::Application *>(app)->widescreenBorders.get() : nullptr;
+    }
+}
+
+extern "C" {
+    int rt64_widescreen_supported(void) {
+        return 1;
+    }
+
+    void rt64_widescreen_set_enabled(void *app, int enabled) {
+        if (RT64::WidescreenBorders *b = getBorders(app)) b->setEnabled(enabled != 0);
+    }
+
+    int rt64_widescreen_is_enabled(void *app) {
+        RT64::WidescreenBorders *b = getBorders(app);
+        return ((b != nullptr) && b->isEnabled()) ? 1 : 0;
+    }
+
+    int rt64_widescreen_set_canvas(void *app, const unsigned char *rgba, int width, int height, int game_width) {
+        RT64::WidescreenBorders *b = getBorders(app);
+        if ((b == nullptr) || (width < 0) || (height < 0) || (game_width < 0)) return 0;
+        return b->setCanvas(rgba, uint32_t(width), uint32_t(height), uint32_t(game_width)) ? 1 : 0;
+    }
+
+    void rt64_widescreen_set_shader_scope(void *app, int scope) {
+        if (RT64::WidescreenBorders *b = getBorders(app)) {
+            b->setShaderScope((scope == RT64_WIDESCREEN_SHADERS_GAME_AND_BORDERS) ? RT64::WidescreenBorders::ShaderScope::GameAndBorders : RT64::WidescreenBorders::ShaderScope::GameOnly);
+        }
+    }
+
+    int rt64_widescreen_get_shader_scope(void *app) {
+        RT64::WidescreenBorders *b = getBorders(app);
+        return ((b != nullptr) && (b->getShaderScope() == RT64::WidescreenBorders::ShaderScope::GameAndBorders)) ? RT64_WIDESCREEN_SHADERS_GAME_AND_BORDERS : RT64_WIDESCREEN_SHADERS_GAME_ONLY;
+    }
+
+    void rt64_widescreen_set_filter(void *app, int linear) {
+        if (RT64::WidescreenBorders *b = getBorders(app)) b->setLinearFiltering(linear != 0);
+    }
+}
diff --git a/src/render/rt64_widescreen_api.h b/src/render/rt64_widescreen_api.h
new file mode 100644
index 0000000..a5f2a4b
--- /dev/null
+++ b/src/render/rt64_widescreen_api.h
@@ -0,0 +1,52 @@
+/*
+ * RT64 widescreen borders: C API.
+ * SPDX-License-Identifier: MIT
+ *
+ * `app` is the RT64::Application* the game created. Safe to call from any thread while rendering.
+ *
+ *   rt64_widescreen_set_canvas(app, rgba, 480, 240, 320);   // 80 + 320 + 80 columns, center = game
+ *   rt64_widescreen_set_enabled(app, 1);
+ *   rt64_widescreen_set_shader_scope(app, RT64_WIDESCREEN_SHADERS_GAME_ONLY);
+ *
+ * Borders show wherever the window is wider than the game image (use the "Original" aspect ratio).
+ */
+
+#ifndef RT64_WIDESCREEN_API_H
+#define RT64_WIDESCREEN_API_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if defined(_WIN32)
+#   define RT64_WIDESCREEN_API
+#else
+#   define RT64_WIDESCREEN_API __attribute__((visibility("default")))
+#endif
+
+#define RT64_WIDESCREEN_SHADERS_GAME_ONLY 0
+#define RT64_WIDESCREEN_SHADERS_GAME_AND_BORDERS 1
+
+/* 1 if this RT64 build can draw widescreen borders. */
+RT64_WIDESCREEN_API int rt64_widescreen_supported(void);
+
+RT64_WIDESCREEN_API void rt64_widescreen_set_enabled(void *app, int enabled);
+RT64_WIDESCREEN_API int rt64_widescreen_is_enabled(void *app);
+
+/* RGBA8 (straight alpha, row-major) canvas; its center game_width columns line up with the game image.
+ * The pixels are copied; the new canvas shows from the next frame. rgba == NULL clears it.
+ * Returns 1 on success, 0 for invalid sizes. */
+RT64_WIDESCREEN_API int rt64_widescreen_set_canvas(void *app, const unsigned char *rgba, int width, int height, int game_width);
+
+/* Which image the post-processing preset applies to (default: game only). */
+RT64_WIDESCREEN_API void rt64_widescreen_set_shader_scope(void *app, int scope);
+RT64_WIDESCREEN_API int rt64_widescreen_get_shader_scope(void *app);
+
+/* 0 = nearest (default, crisp pixels), 1 = linear. */
+RT64_WIDESCREEN_API void rt64_widescreen_set_filter(void *app, int linear);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
