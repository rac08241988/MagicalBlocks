+# MMPX (Morgan McGuire & Mara Gagiu, MIT) - 2x style-preserving pixel art magnification,
+# followed by a bilinear resample to the window (RT64 MIT passthrough instead of libretro's bicubic).
+shaders = 2
+
+shader0 = mmpx.slang
+filter_linear0 = false
+scale_type0 = source
+scale0 = 2.0
+
+shader1 = ../common/passthrough.slang
+filter_linear1 = true
+scale_type1 = viewport
