+static void testProgram() {
+    MemoryFileProvider files;
+    files.addFile("/s/test.slang", TestShader);
+    files.addFile("/s/common.inc", TestInclude);
+    files.addFile("/s/pass0.slang", getBuiltinFiles().files.at("@builtin/common/passthrough.slang"));
+    files.addFile("/s/test.slangp", R"(shaders = 2
+shader0 = pass0.slang
+alias0 = first
+filter_linear0 = true
+wrap_mode0 = repeat
+scale_type0 = source
+scale0 = 2
+shader1 = test.slang
+filter_linear1 = false
+textures = LutTex
+LutTex = lut.png
+LutTex_linear = true
+STRENGTH = 0.75
+)");
+
+    for (SlangTarget target : { SlangTarget::SPIRV, SlangTarget::HLSL }) {
+        Program program;
+        std::string error;
+        bool ok = buildProgram(files, "/s/test.slangp", target, program, error);
+        if (!ok) {
+            fprintf(stderr, "%s\n", error.c_str());
+        }
+
+        CHECK(ok);
+        if (!ok) {
+            continue;
+        }
+
+        CHECK(program.passes.size() == 2);
+        CHECK(program.parameters.size() == 2);
+        CHECK(program.findParameter("STRENGTH") == 0);
+        CHECK(program.parameters[0].value == 0.75f);
+        CHECK(program.parameters[1].value == 2.0f);
+        CHECK(!program.passes[1].compiled.vertexSpirv.empty() && (program.passes[1].compiled.vertexSpirv[0] == 0x07230203u));
+        CHECK(!program.passes[1].compiled.fragmentSpirv.empty());
+        if (target == SlangTarget::HLSL) {
+            CHECK(program.passes[1].compiled.fragmentHlsl.find("register(t1)") != std::string::npos);
+            CHECK(program.passes[1].compiled.fragmentHlsl.find("register(s1)") != std::string::npos);
+            CHECK(program.passes[1].compiled.fragmentHlsl.find("register(b0)") != std::string::npos);
+            CHECK(program.passes[1].compiled.fragmentHlsl.find("register(b1)") != std::string::npos);
+        }
+        else {
+            CHECK(program.passes[1].compiled.fragmentHlsl.empty());
+        }
+
+        const ProgramPass &pass = program.passes[1];
+        CHECK(pass.compiled.push.present && pass.compiled.ubo.present);
+        CHECK(pass.textures.size() == 5);
+        auto findTexture = [&](const std::string &name) -> const TextureBindingPlan * {
+            for (const TextureBindingPlan &t : pass.textures) {
+                if (t.name == name) {
+                    return &t;
+                }
+            }
+
+            return nullptr;
+        };
+
+        const TextureBindingPlan *src = findTexture("Source");
+        const TextureBindingPlan *orig = findTexture("Original");
+        const TextureBindingPlan *first = findTexture("first");
+        const TextureBindingPlan *lut = findTexture("LutTex");
+        const TextureBindingPlan *mystery = findTexture("Mystery");
+        CHECK(src && src->semantic == TextureSemantic::Source && src->binding == 1 && !src->linear);
+        CHECK(orig && orig->semantic == TextureSemantic::Original && orig->linear && orig->wrapMode == WrapMode::Repeat);
+        // PassOutput0 is sampled with pass 1's (its consumer's) settings.
+        CHECK(first && first->semantic == TextureSemantic::PassOutput && first->index == 0 && !first->linear);
+        CHECK(lut && lut->semantic == TextureSemantic::Lut && lut->index == 0 && lut->linear);
+        CHECK(mystery && mystery->semantic == TextureSemantic::Black);
+
+        auto findUniform = [&](const std::string &name) -> const UniformPlan * {
+            for (const UniformPlan &u : pass.uniforms) {
+                if (u.name == name) {
+                    return &u;
+                }
+            }
+
+            return nullptr;
+        };
+
+        const UniformPlan *mvp = findUniform("MVP");
+        const UniformPlan *strength = findUniform("STRENGTH");
+        const UniformPlan *frameCount = findUniform("FrameCount");
+        const UniformPlan *passSize = findUniform("PassOutput0Size");
+        const UniformPlan *lutSize = findUniform("LutTexSize");
+        const UniformPlan *unknown = findUniform("NotAThing");
+        CHECK(mvp && mvp->semantic == UniformSemantic::MVP && !mvp->pushConstant && mvp->offset == 0);
+        CHECK(strength && strength->semantic == UniformSemantic::Parameter && strength->pushConstant && strength->index == 0);
+        CHECK(frameCount && frameCount->semantic == UniformSemantic::FrameCount && frameCount->type == MemberType::UInt);
+        CHECK(passSize && passSize->semantic == UniformSemantic::PassOutputSize && passSize->index == 0);
+        CHECK(lutSize && lutSize->semantic == UniformSemantic::LutSize);
+        CHECK(unknown && unknown->semantic == UniformSemantic::Zero);
+        CHECK(!program.warnings.empty());
+
+        // Sizes: pass0 = source x2, last pass unspecified = viewport.
+        std::vector<Size2D> sizes = computePassSizes(program, { 320, 240 }, { 1280, 960 });
+        CHECK(sizes.size() == 2 && sizes[0].width == 640 && sizes[0].height == 480 && sizes[1].width == 1280 && sizes[1].height == 960);
+
+        // Uniform bytes.
+        FrameState frame;
+        frame.original = { 320, 240 };
+        frame.viewport = { 1280, 960 };
+        frame.frameCount = 12;
+        frame.passSizes = sizes;
+        frame.lutSizes = { { 16, 16 } };
+        std::vector<float> values = { 0.75f, 2.0f };
+        frame.parameterValues = values.data();
+        frame.parameterCount = values.size();
+        std::vector<uint8_t> ubo, push;
+        writePassUniforms(pass, 1, frame, ubo, push);
+        CHECK(ubo.size() == pass.compiled.ubo.size && push.size() == pass.compiled.push.size);
+        auto readFloat = [](const std::vector<uint8_t> &data, uint32_t offset) {
+            float f = 0.0f;
+            if (offset + 4 <= data.size()) {
+                memcpy(&f, data.data() + offset, 4);
+            }
+
+            return f;
+        };
+
+        const ReflectedMember *sourceSize = pass.compiled.push.find("SourceSize");
+        const ReflectedMember *outputSize = pass.compiled.push.find("OutputSize");
+        const ReflectedMember *fc = pass.compiled.push.find("FrameCount");
+        const ReflectedMember *str = pass.compiled.push.find("STRENGTH");
+        const ReflectedMember *orgSize = pass.compiled.ubo.find("OriginalSize");
+        CHECK(sourceSize && readFloat(push, sourceSize->offset) == 640.0f && readFloat(push, sourceSize->offset + 8) == 1.0f / 640.0f);
+        CHECK(outputSize && readFloat(push, outputSize->offset + 4) == 960.0f);
+        CHECK(str && readFloat(push, str->offset) == 0.75f);
+        CHECK(orgSize && readFloat(ubo, orgSize->offset) == 320.0f);
+        uint32_t frameValue = 0;
+        if (fc) {
+            memcpy(&frameValue, push.data() + fc->offset, 4);
+        }
+
+        CHECK(frameValue == 12);
+        CHECK(readFloat(ubo, 0) == 2.0f && readFloat(ubo, 48) == -1.0f && readFloat(ubo, 60) == 1.0f);
+    }
+
+    // Shaders that the preprocessor accepts but the compiler must reject.
+    files.addFile("/s/broken.slang", "#version 450\n#pragma stage vertex\nvoid main() { gl_Position = vec4(0.0); }\n#pragma stage fragment\nlayout(location = 0) out vec4 FragColor;\nvoid main() { FragColor = undefinedThing; }\n");
+    files.addFile("/s/broken.slangp", "shaders = 1\nshader0 = broken.slang\n");
+    Program program;
+    std::string error;
+    CHECK(!buildProgram(files, "/s/broken.slangp", SlangTarget::SPIRV, program, error));
+    CHECK(error.find("undefinedThing") != std::string::npos);
+
+    // Duplicate aliases.
+    files.addFile("/s/dupalias.slangp", "shaders = 2\nshader0 = pass0.slang\nalias0 = x\nshader1 = pass0.slang\nalias1 = x\n");
+    CHECK(!buildProgram(files, "/s/dupalias.slangp", SlangTarget::SPIRV, program, error));
+}
