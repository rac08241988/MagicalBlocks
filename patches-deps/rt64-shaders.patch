@@ -0,0 +1,73 @@
+/*
+ * RT64 slang post-processing: C API for game menus.
+ * SPDX-License-Identifier: MIT
+ *
+ * `app` is the RT64::Application* the game created. All functions are safe to call from the game
+ * or UI thread while the renderer is running. Returned strings stay valid until the next call to
+ * the same function family on the same application (copy them if you need them longer).
+ *
+ * Typical menu flow:
+ *   int n = rt64_postprocess_refresh_presets(app);              // builtins + <exe>/shaders
+ *   for (int i = 0; i < n; i++) show(rt64_postprocess_preset_name(app, i), rt64_postprocess_preset_id(app, i));
+ *   if (!rt64_postprocess_set_preset(app, chosen_id)) show_error(rt64_postprocess_last_error(app));
+ *   save_config(rt64_postprocess_active_preset(app));           // "" when disabled
+ */
+
+#ifndef RT64_POSTPROCESS_API_H
+#define RT64_POSTPROCESS_API_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if defined(_WIN32)
+#   define RT64_POSTPROCESS_API
+#else
+#   define RT64_POSTPROCESS_API __attribute__((visibility("default")))
+#endif
+
+typedef struct RT64PostProcessParameter {
+    const char *id;
+    const char *description;
+    float value;
+    float initial;
+    float minimum;
+    float maximum;
+    float step;
+} RT64PostProcessParameter;
+
+/* 1 if this RT64 build has post-processing support. */
+RT64_POSTPROCESS_API int rt64_postprocess_supported(void);
+
+/* Folder with external presets (UTF-8). Defaults to "shaders" next to the executable. */
+RT64_POSTPROCESS_API void rt64_postprocess_set_search_directory(void *app, const char *directory);
+RT64_POSTPROCESS_API const char *rt64_postprocess_get_search_directory(void *app);
+
+/* Rebuilds the preset list (built-ins first) and returns its size. */
+RT64_POSTPROCESS_API int rt64_postprocess_refresh_presets(void *app);
+RT64_POSTPROCESS_API const char *rt64_postprocess_preset_id(void *app, int index);
+RT64_POSTPROCESS_API const char *rt64_postprocess_preset_name(void *app, int index);
+RT64_POSTPROCESS_API const char *rt64_postprocess_preset_license(void *app, int index);
+RT64_POSTPROCESS_API int rt64_postprocess_preset_is_builtin(void *app, int index);
+
+/* id from the list, a path relative to the search directory or an absolute path; NULL/""/"none"
+ * disables. Compiles synchronously (typically 10-300 ms) and switches on the next frame.
+ * Returns 1 on success, 0 on failure (the previous preset stays active). */
+RT64_POSTPROCESS_API int rt64_postprocess_set_preset(void *app, const char *id_or_path);
+RT64_POSTPROCESS_API const char *rt64_postprocess_active_preset(void *app);
+RT64_POSTPROCESS_API const char *rt64_postprocess_last_error(void *app);
+
+/* Parameters ("#pragma parameter") of the active preset. Changes apply on the next frame. */
+RT64_POSTPROCESS_API int rt64_postprocess_parameter_count(void *app);
+RT64_POSTPROCESS_API int rt64_postprocess_get_parameter(void *app, int index, RT64PostProcessParameter *out);
+RT64_POSTPROCESS_API int rt64_postprocess_set_parameter(void *app, const char *id, float value);
+RT64_POSTPROCESS_API void rt64_postprocess_reset_parameters(void *app);
+
+/* Third-party notices (Markdown) for the embedded shaders, for an "About/Licenses" screen. */
+RT64_POSTPROCESS_API const char *rt64_postprocess_builtin_notices(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/postfx/rt64_slang_builtin.cpp b/src/postfx/rt64_slang_builtin.cpp
new file mode 100644
index 0000000..7171397
--- /dev/null
+++ b/src/postfx/rt64_slang_builtin.cpp
@@ -0,0 +1,98 @@
+//
+// RT64 slang post-processing: presets embedded into the binary.
+// SPDX-License-Identifier: MIT
+//
+
+#include "rt64_slang_builtin.h"
+
+#include <cctype>
+
+namespace RT64 {
+namespace SlangFX {
+    const MemoryFileProvider &getBuiltinFiles() {
+        static const MemoryFileProvider provider = []() {
+            MemoryFileProvider p;
+            size_t count = 0;
+            const BuiltinFileEntry *table = getBuiltinFileTable(count);
+            for (size_t i = 0; i < count; i++) {
+                p.addFile(std::string(BuiltinRoot) + table[i].path, std::string(table[i].data, table[i].size));
+            }
+
+            return p;
+        }();
+
+        return provider;
+    }
+
+    static std::string trim(const std::string &s) {
+        size_t a = 0;
+        size_t b = s.size();
+        while ((a < b) && std::isspace((unsigned char)(s[a]))) {
+            a++;
+        }
+
+        while ((b > a) && std::isspace((unsigned char)(s[b - 1]))) {
+            b--;
+        }
+
+        return s.substr(a, b - a);
+    }
+
+    const std::vector<BuiltinPresetInfo> &getBuiltinPresets() {
+        static const std::vector<BuiltinPresetInfo> presets = []() {
+            std::vector<BuiltinPresetInfo> list;
+            std::string manifest;
+            if (!getBuiltinFiles().readFile(std::string(BuiltinRoot) + "manifest.txt", manifest)) {
+                return list;
+            }
+
+            size_t start = 0;
+            while (start < manifest.size()) {
+                size_t end = manifest.find('\n', start);
+                if (end == std::string::npos) {
+                    end = manifest.size();
+                }
+
+                std::string line = trim(manifest.substr(start, end - start));
+                start = end + 1;
+                if (line.empty() || (line[0] == '#')) {
+                    continue;
+                }
+
+                std::vector<std::string> fields;
+                size_t fieldStart = 0;
+                while (fieldStart <= line.size()) {
+                    size_t bar = line.find('|', fieldStart);
+                    if (bar == std::string::npos) {
+                        bar = line.size();
+                    }
+
+                    fields.emplace_back(trim(line.substr(fieldStart, bar - fieldStart)));
+                    fieldStart = bar + 1;
+                }
+
+                if (fields.size() < 4) {
+                    continue;
+                }
+
+                BuiltinPresetInfo info;
+                info.id = "builtin:" + fields[0];
+                info.presetPath = std::string(BuiltinRoot) + fields[1];
+                info.displayName = fields[2];
+                info.license = fields[3];
+                list.emplace_back(info);
+            }
+
+            return list;
+        }();
+
+        return presets;
+    }
+
+    std::string getBuiltinNotices() {
+        std::string notices;
+        getBuiltinFiles().readFile(std::string(BuiltinRoot) + "NOTICES.md", notices);
+        return notices;
+    }
+};
+};
diff --git a/src/postfx/rt64_slang_builtin.h b/src/postfx/rt64_slang_builtin.h
