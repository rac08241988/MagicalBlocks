diff --git a/src/d3d12/rt64_d3d12.cpp b/src/d3d12/rt64_d3d12.cpp
index b5f04de..a23bb41 100644
--- a/src/d3d12/rt64_d3d12.cpp
+++ b/src/d3d12/rt64_d3d12.cpp
@@ -1867,9 +1867,16 @@ namespace RT64 {
 
         const D3D12_TEXTURE_COPY_LOCATION copyDstLocation = toD3D12(dstLocation);
         const D3D12_TEXTURE_COPY_LOCATION copySrcLocation = toD3D12(srcLocation);
-        setSamplePositions(dstLocation.texture);
+        // [magical-tetris shaders] The destination is a buffer for texture -> buffer readbacks.
+        const bool dstIsTexture = (dstLocation.texture != nullptr);
+        if (dstIsTexture) {
+            setSamplePositions(dstLocation.texture);
+        }
+
         d3d->CopyTextureRegion(&copyDstLocation, dstX, dstY, dstZ, &copySrcLocation, (srcBox != nullptr) ? &copyBox : nullptr);
-        resetSamplePositions();
+        if (dstIsTexture) {
+            resetSamplePositions();
+        }
     }
 
     void D3D12CommandList::copyBuffer(const RenderBuffer *dstBuffer, const RenderBuffer *srcBuffer) {
diff --git a/src/rhi/rt64_render_interface_builders.h b/src/rhi/rt64_render_interface_builders.h
index b3bf414..a5cdadb 100644
--- a/src/rhi/rt64_render_interface_builders.h
+++ b/src/rhi/rt64_render_interface_builders.h
@@ -65,6 +65,14 @@ namespace RT64 {
             return addRange(RenderDescriptorRange(RenderDescriptorRangeType::SAMPLER, binding, count, samplerPointerVectorList.back().data()));
         }
 
+        // Vulkan only (see RenderDescriptorRangeType::COMBINED_TEXTURE_SAMPLER). Write it with setTexture().
+        uint32_t addCombinedTextureSampler(uint32_t binding, const RenderSampler *immutableSampler) {
+            assert(immutableSampler != nullptr);
+
+            samplerPointerVectorList.emplace_back(std::vector<const RenderSampler *>(1, immutableSampler));
+            return addRange(RenderDescriptorRange(RenderDescriptorRangeType::COMBINED_TEXTURE_SAMPLER, binding, 1, samplerPointerVectorList.back().data()));
+        }
+
         uint32_t addStructuredBuffer(uint32_t binding, uint32_t count = 1) {
             return addRange(RenderDescriptorRange(RenderDescriptorRangeType::STRUCTURED_BUFFER, binding, count, nullptr));
         }
diff --git a/src/rhi/rt64_render_interface_types.h b/src/rhi/rt64_render_interface_types.h
index e450855..980c6c1 100755
--- a/src/rhi/rt64_render_interface_types.h
+++ b/src/rhi/rt64_render_interface_types.h
@@ -340,7 +340,11 @@ namespace RT64 {
         READ_WRITE_STRUCTURED_BUFFER,
         BYTE_ADDRESS_BUFFER,
         READ_WRITE_BYTE_ADDRESS_BUFFER,
-        ACCELERATION_STRUCTURE
+        ACCELERATION_STRUCTURE,
+        // [magical-tetris shaders] Vulkan-only: a combined image sampler (GLSL sampler2D), which must
+        // use an immutable sampler. Backends that don't support it (D3D12, Metal) never receive it;
+        // callers must check RenderShaderFormat::SPIRV first.
+        COMBINED_TEXTURE_SAMPLER
     };
 
     enum class RenderHeapType {
diff --git a/src/vulkan/rt64_vulkan.cpp b/src/vulkan/rt64_vulkan.cpp
index c814269..a8f0d9c 100644
--- a/src/vulkan/rt64_vulkan.cpp
+++ b/src/vulkan/rt64_vulkan.cpp
@@ -485,6 +485,8 @@ namespace RT64 {
             return VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
         case RenderDescriptorRangeType::ACCELERATION_STRUCTURE:
             return VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR;
+        case RenderDescriptorRangeType::COMBINED_TEXTURE_SAMPLER:
+            return VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
         default:
             assert(false && "Unknown descriptor range type.");
             return VK_DESCRIPTOR_TYPE_MAX_ENUM;
@@ -2935,6 +2937,28 @@ namespace RT64 {
             imageCopy.imageExtent.depth = srcLocation.placedFootprint.depth;
             vkCmdCopyBufferToImage(vk, srcBuffer->vk, dstTexture->vk, toImageLayout(dstTexture->textureLayout), 1, &imageCopy);
         }
+        else if ((dstLocation.type == RenderTextureCopyType::PLACED_FOOTPRINT) && (srcLocation.type == RenderTextureCopyType::SUBRESOURCE)) {
+            // [magical-tetris shaders] Texture -> buffer readback (D3D12 already supports this direction).
+            assert(dstBuffer != nullptr);
+            assert(srcTexture != nullptr);
+
+            const uint32_t blockWidth = RenderFormatBlockWidth(srcTexture->desc.format);
+            VkBufferImageCopy imageCopy = {};
+            imageCopy.bufferOffset = dstLocation.placedFootprint.offset;
+            imageCopy.bufferRowLength = ((dstLocation.placedFootprint.rowWidth + blockWidth - 1) / blockWidth) * blockWidth;
+            imageCopy.bufferImageHeight = ((dstLocation.placedFootprint.height + blockWidth - 1) / blockWidth) * blockWidth;
+            imageCopy.imageSubresource.aspectMask = (srcTexture->desc.flags & RenderTextureFlag::DEPTH_TARGET) ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT;
+            imageCopy.imageSubresource.baseArrayLayer = 0;
+            imageCopy.imageSubresource.layerCount = 1;
+            imageCopy.imageSubresource.mipLevel = srcLocation.subresource.index;
+            imageCopy.imageOffset.x = (srcBox != nullptr) ? srcBox->left : 0;
+            imageCopy.imageOffset.y = (srcBox != nullptr) ? srcBox->top : 0;
+            imageCopy.imageOffset.z = (srcBox != nullptr) ? srcBox->front : 0;
+            imageCopy.imageExtent.width = dstLocation.placedFootprint.width;
+            imageCopy.imageExtent.height = dstLocation.placedFootprint.height;
+            imageCopy.imageExtent.depth = dstLocation.placedFootprint.depth;
+            vkCmdCopyImageToBuffer(vk, srcTexture->vk, toImageLayout(srcTexture->textureLayout), dstBuffer->vk, 1, &imageCopy);
+        }
         else {
             VkImageCopy imageCopy = {};
             imageCopy.srcSubresource.aspectMask = (srcTexture->desc.flags & RenderTextureFlag::DEPTH_TARGET) ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT;
