+static bool writeBinary(const std::filesystem::path &path, const void *data, size_t size) {
+    std::ofstream out(path, std::ios::binary);
+    out.write(reinterpret_cast<const char *>(data), std::streamsize(size));
+    return out.good();
+}
+
+static std::string safeName(const std::string &id) {
+    std::string out;
+    for (char c : id) {
+        out += (std::isalnum((unsigned char)(c)) || (c == '-') || (c == '_')) ? c : '_';
+    }
+
+    return out;
+}
+
+static const char *semanticName(TextureSemantic s) {
+    switch (s) {
+    case TextureSemantic::Original: return "Original";
+    case TextureSemantic::Source: return "Source";
+    case TextureSemantic::PassOutput: return "PassOutput";
+    case TextureSemantic::Lut: return "LUT";
+    default: return "Black";
+    }
+}
+
+static int runCompile(int argc, char **argv) {
+    if (argc < 3) {
+        fprintf(stderr, "usage: %s compile <outdir> [--hlsl] [--root] [preset...]\n", argv[0]);
+        return 2;
+    }
+
+    std::filesystem::path outDir = argv[2];
+    SlangTarget target = SlangTarget::SPIRV;
+    std::vector<std::pair<std::string, std::string>> presets;
+    for (int i = 3; i < argc; i++) {
+        if (strcmp(argv[i], "--hlsl") == 0) {
+            target = SlangTarget::HLSL;
+        }
+        else {
+            const std::string arg = argv[i];
+            bool found = false;
+            for (const BuiltinPresetInfo &info : getBuiltinPresets()) {
+                if ((info.id == arg) || (info.id == "builtin:" + arg)) {
+                    presets.emplace_back(info.id, info.presetPath);
+                    found = true;
+                }
+            }
+
+            if (!found) {
+                presets.emplace_back("file:" + pathStem(arg), normalizePath(std::filesystem::absolute(arg).generic_string()));
+            }
+        }
+    }
+
+    if (presets.empty()) {
+        for (const BuiltinPresetInfo &info : getBuiltinPresets()) {
+            presets.emplace_back(info.id, info.presetPath);
+        }
+    }
+
+    DiskFileProvider disk;
+    LayeredFileProvider files;
+    files.builtin = &getBuiltinFiles();
+    files.disk = &disk;
+
+    int failures = 0;
+    for (const auto &entry : presets) {
+        Program program;
+        std::string error;
+        if (!buildProgram(files, entry.second, target, program, error)) {
+            fprintf(stderr, "FAILED %s: %s\n", entry.first.c_str(), error.c_str());
+            failures++;
+            continue;
+        }
+
+        const std::filesystem::path dir = outDir / safeName(entry.first);
+        std::filesystem::create_directories(dir);
+        std::ostringstream report;
+        report << "preset " << entry.first << " (" << entry.second << ")\n";
+        for (const ProgramParameter &parameter : program.parameters) {
+            report << "  parameter " << parameter.info.id << " = " << parameter.value << " [" << parameter.info.minimum << ", " << parameter.info.maximum << "] step " << parameter.info.step << " \"" << parameter.info.description << "\"\n";
+        }
+
+        for (size_t p = 0; p < program.passes.size(); p++) {
+            const ProgramPass &pass = program.passes[p];
+            const std::string base = "pass" + std::to_string(p);
+            writeBinary(dir / (base + ".vert.spv"), pass.compiled.vertexSpirv.data(), pass.compiled.vertexSpirv.size() * sizeof(uint32_t));
+            writeBinary(dir / (base + ".frag.spv"), pass.compiled.fragmentSpirv.data(), pass.compiled.fragmentSpirv.size() * sizeof(uint32_t));
+            if (target == SlangTarget::HLSL) {
+                writeBinary(dir / (base + ".vert.hlsl"), pass.compiled.vertexHlsl.data(), pass.compiled.vertexHlsl.size());
+                writeBinary(dir / (base + ".frag.hlsl"), pass.compiled.fragmentHlsl.data(), pass.compiled.fragmentHlsl.size());
+            }
+
+            report << "  pass " << p << ": " << pass.source.path << " format " << int(pass.format) << " ubo " << (pass.compiled.ubo.present ? int(pass.compiled.ubo.size) : -1) << " push " << (pass.compiled.push.present ? int(pass.compiled.push.size) : -1) << "\n";
+            for (const TextureBindingPlan &texture : pass.textures) {
+                report << "    texture " << texture.name << " binding " << texture.binding << " -> " << semanticName(texture.semantic) << " " << texture.index << (texture.linear ? " linear" : " nearest") << " wrap " << int(texture.wrapMode) << "\n";
+            }
+
+            for (const UniformPlan &uniform : pass.uniforms) {
+                report << "    uniform " << uniform.name << (uniform.pushConstant ? " push" : " ubo") << " @" << uniform.offset << " semantic " << int(uniform.semantic) << " index " << uniform.index << "\n";
+            }
+        }
+
+        for (const std::string &warning : program.warnings) {
+            report << "  warning: " << warning << "\n";
+        }
+
+        std::string text = report.str();
+        writeBinary(dir / "report.txt", text.data(), text.size());
+        printf("OK %s: %zu passes, %zu parameters, %zu warnings\n", entry.first.c_str(), program.passes.size(), program.parameters.size(), program.warnings.size());
+    }
+
+    return (failures == 0) ? 0 : 1;
+}
