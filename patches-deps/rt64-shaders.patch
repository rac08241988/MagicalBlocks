+#if RT64_POSTFX_TOOL_DXC
+// Compiles every built-in preset to DXIL through RT64::ShaderCompiler, exactly as the D3D12 runtime does.
+static int runDxil() {
+    RT64::ShaderCompiler compiler;
+    if (compiler.dxcCompiler == nullptr) {
+        fprintf(stderr, "dxcompiler.dll could not be loaded\n");
+        return 1;
+    }
+
+    int failures = 0;
+    for (const BuiltinPresetInfo &info : getBuiltinPresets()) {
+        Program program;
+        std::string error;
+        if (!buildProgram(getBuiltinFiles(), info.presetPath, SlangTarget::HLSL, program, error)) {
+            fprintf(stderr, "FAILED %s: %s\n", info.id.c_str(), error.c_str());
+            failures++;
+            continue;
+        }
+
+        size_t bytes = 0;
+        for (const ProgramPass &pass : program.passes) {
+            const std::pair<const std::string *, const wchar_t *> stages[] = { { &pass.compiled.vertexHlsl, L"vs_6_0" }, { &pass.compiled.fragmentHlsl, L"ps_6_0" } };
+            for (const auto &stage : stages) {
+                IDxcBlob *blob = nullptr;
+                try {
+                    compiler.compile(*stage.first, L"main", stage.second, RT64::RenderShaderFormat::DXIL, &blob);
+                }
+                catch (const std::exception &e) {
+                    fprintf(stderr, "FAILED %s (%s): %s\n", info.id.c_str(), pass.source.path.c_str(), e.what());
+                    failures++;
+                    continue;
+                }
+
+                if (blob == nullptr) {
+                    fprintf(stderr, "FAILED %s: no blob\n", info.id.c_str());
+                    failures++;
+                    continue;
+                }
+
+                const char *data = reinterpret_cast<const char *>(blob->GetBufferPointer());
+                if ((blob->GetBufferSize() < 4) || (memcmp(data, "DXBC", 4) != 0)) {
+                    fprintf(stderr, "FAILED %s: not a DXBC container\n", info.id.c_str());
+                    failures++;
+                }
+
+                bytes += blob->GetBufferSize();
+                blob->Release();
+            }
+        }
+
+        printf("DXIL OK %s: %zu passes, %zu bytes\n", info.id.c_str(), program.passes.size(), bytes);
+    }
+
+    return (failures == 0) ? 0 : 1;
+}
+#endif
+
+int main(int argc, char **argv) {
+    if ((argc >= 2) && (strcmp(argv[1], "selftest") == 0)) {
+        return runSelfTest();
+    }
+    else if ((argc >= 2) && (strcmp(argv[1], "compile") == 0)) {
+        return runCompile(argc, argv);
+    }
+#if RT64_POSTFX_TOOL_DXC
+    else if ((argc >= 2) && (strcmp(argv[1], "dxil") == 0)) {
+        return runDxil();
+    }
+#endif
+
+    fprintf(stderr, "usage: %s selftest | compile <outdir> [--hlsl] [preset ids or .slangp paths...]\n", argv[0]);
+    return 2;
+}
-- 
