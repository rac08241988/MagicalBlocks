+        CHECK(preset.passes[0].wrapMode == WrapMode::Repeat);
+        CHECK(preset.passes[0].floatFramebuffer);
+        CHECK_EQ_STR(preset.passes[0].alias, "first");
+        CHECK(preset.passes[1].scaleTypeX == ScaleType::Unspecified);
+    }
