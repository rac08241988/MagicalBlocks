+# ScaleFX (Sp00kyFox, MIT) - 3x edge interpolation for pixel art.
+# Same pass layout as libretro's edge-smoothing/scalefx/scalefx.slangp, except pass 0 uses RT64's
+# own MIT passthrough instead of stock.slang. The 3x result is scaled to the window by RT64.
+shaders = 6
+
+shader0 = ../common/passthrough.slang
+alias0 = refpass
+filter_linear0 = false
+scale_type0 = source
+scale0 = 1.0
+
+shader1 = scalefx-pass0.slang
+filter_linear1 = false
+scale_type1 = source
+scale1 = 1.0
+float_framebuffer1 = true
+alias1 = scalefx_pass0
+
+shader2 = scalefx-pass1.slang
+filter_linear2 = false
+scale_type2 = source
+scale2 = 1.0
+float_framebuffer2 = true
+
+shader3 = scalefx-pass2.slang
+filter_linear3 = false
+scale_type3 = source
+scale3 = 1.0
+
+shader4 = scalefx-pass3.slang
+filter_linear4 = false
+scale_type4 = source
+scale4 = 1.0
+
+shader5 = scalefx-pass4.slang
+filter_linear5 = false
+scale_type5 = source
+scale5 = 3.0
