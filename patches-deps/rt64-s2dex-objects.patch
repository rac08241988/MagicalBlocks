index 0000000..c919ad4
--- /dev/null
+++ b/src/gbi/rt64_s2dex_obj.cpp
@@ -0,0 +1,337 @@
+//
+// RT64
+//
+// S2DEX object (sprite) command math. See rt64_s2dex_obj.h.
+//
+
+#include "rt64_s2dex_obj.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace RT64 {
+    namespace S2DEXObj {
+        static int32_t floorDiv(int64_t num, int64_t den) {
+            int64_t q = num / den;
+            if (((num % den) != 0) && ((num < 0) != (den < 0))) {
+                q--;
+            }
+
+            return int32_t(q);
+        }
+
+        static uint16_t beU16(const MatrixBytes &b, uint32_t o) {
+            return uint16_t((b[o] << 8) | b[o + 1]);
+        }
+
+        static uint32_t beU32(const MatrixBytes &b, uint32_t o) {
+            return (uint32_t(beU16(b, o)) << 16) | beU16(b, o + 2);
+        }
+
+        // Texels trimmed from each edge by the SHRINKSIZE modes, in s10.5.
+        static int32_t shrinkAmount(uint32_t renderMode) {
+            if (renderMode & OBJRM_SHRINKSIZE_2) {
+                return 32;
+            }
+            else if (renderMode & OBJRM_SHRINKSIZE_1) {
+                return 16;
+            }
+            else {
+                return 0;
+            }
+        }
+
+        Sprite decodeSprite(const uint8_t *swapped, uint32_t offset) {
+            Sprite s;
+            s.objX = int16_t(readU16(swapped, offset + 0));
+            s.scaleW = readU16(swapped, offset + 2);
+            s.imageW = readU16(swapped, offset + 4);
+            s.objY = int16_t(readU16(swapped, offset + 8));
+            s.scaleH = readU16(swapped, offset + 10);
+            s.imageH = readU16(swapped, offset + 12);
+            s.imageStride = readU16(swapped, offset + 16);
+            s.imageAdrs = readU16(swapped, offset + 18);
+            s.imageFmt = readU8(swapped, offset + 20);
+            s.imageSiz = readU8(swapped, offset + 21);
+            s.imagePal = readU8(swapped, offset + 22);
+            s.imageFlags = readU8(swapped, offset + 23);
+            return s;
+        }
+
+        Matrix decodeMatrix(const MatrixBytes &b) {
+            Matrix m;
+            m.A = int32_t(beU32(b, 0));
+            m.B = int32_t(beU32(b, 4));
+            m.C = int32_t(beU32(b, 8));
+            m.D = int32_t(beU32(b, 12));
+            m.X = int16_t(beU16(b, 16));
+            m.Y = int16_t(beU16(b, 18));
+            m.baseScaleX = beU16(b, 20);
+            m.baseScaleY = beU16(b, 22);
+            return m;
+        }
+
+        void resetMatrix(MatrixBytes &b) {
+            // Identity matrix, no translation, BaseScale 1.0.
+            const uint8_t identity[OBJ_MTX_SIZE] = {
+                0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+                0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00,
+                0x00, 0x00, 0x00, 0x00, 0x04, 0x00, 0x04, 0x00
+            };
+
+            std::copy(std::begin(identity), std::end(identity), b.begin());
+        }
+
+        uint32_t moveMem(MatrixBytes &b, const uint8_t *swappedSrc, uint32_t w0) {
+            const uint32_t size = ((w0 >> 16) & 0xFF) + 1;
+            const uint32_t offset = (w0 & 0xFFFF) * 8;
+            uint32_t copied = 0;
+            for (uint32_t i = 0; (i < size) && ((offset + i) < OBJ_MTX_SIZE); i++) {
+                b[offset + i] = readU8(swappedSrc, i);
+                copied++;
+            }
+
+            return copied;
+        }
+
+        TileParams spriteTile(const Sprite &sprite, uint32_t renderMode) {
+            TileParams t;
+            t.fmt = sprite.imageFmt & 0x7;
+            t.siz = sprite.imageSiz & 0x3;
+            t.palette = sprite.imagePal & 0xF;
+            t.line = sprite.imageStride & 0x1FF;
+            t.tmem = sprite.imageAdrs & 0x1FF;
+            t.cms = t.cmt = (renderMode & OBJRM_NOTXCLAMP) ? TX_WRAP : TX_CLAMP;
+            t.uls = 0;
+            t.ult = 0;
+            // u10.5 image size -> 10.2 coordinate of the last texel.
+            t.lrs = uint16_t(std::max(int32_t(sprite.imageW) - 32, 0) >> 3);
+            t.lrt = uint16_t(std::max(int32_t(sprite.imageH) - 32, 0) >> 3);
+            return t;
+        }
+
+        TexRect objRectangle(const Sprite &sprite, uint32_t renderMode, bool copyMode, const Scissor &scissor, const Matrix *subMatrix) {
+            TexRect r;
+            const int32_t scaleW = std::max<int32_t>(sprite.scaleW, 1);
+            const int32_t scaleH = std::max<int32_t>(sprite.scaleH, 1);
+            const int32_t shrink = shrinkAmount(renderMode);
+            const int32_t texW = int32_t(sprite.imageW) - 2 * shrink;
+            const int32_t texH = int32_t(sprite.imageH) - 2 * shrink;
+            if ((texW <= 0) || (texH <= 0)) {
+                return r;
+            }
+
+            // Texels advanced per screen pixel (u5.10).
+            int64_t stepS = scaleW;
+            int64_t stepT = scaleH;
+            int32_t ulx = sprite.objX;
+            int32_t uly = sprite.objY;
+            if (subMatrix != nullptr) {
+                // ObjRectangleR: the position and size are additionally divided
+                // by BaseScale and offset by the 2D matrix translation.
+                const int64_t baseX = std::max<int32_t>(subMatrix->baseScaleX, 1);
+                const int64_t baseY = std::max<int32_t>(subMatrix->baseScaleY, 1);
+                ulx = subMatrix->X + floorDiv(int64_t(sprite.objX) * 1024, baseX);
+                uly = subMatrix->Y + floorDiv(int64_t(sprite.objY) * 1024, baseY);
+                stepS = std::max<int64_t>((stepS * baseX) >> 10, 1);
+                stepT = std::max<int64_t>((stepT * baseY) >> 10, 1);
+            }
+
+            // Screen size in 10.2: (u10.5 texels << 7) / u5.10 step.
+            const int32_t widthQ = int32_t((int64_t(texW) << 7) / stepS);
+            const int32_t heightQ = int32_t((int64_t(texH) << 7) / stepT);
+            if ((widthQ <= 0) || (heightQ <= 0)) {
+                return r;
+            }
+
+            int32_t lrx = ulx + widthQ;
+            int32_t lry = uly + heightQ;
+            const bool flipS = (sprite.imageFlags & OBJ_FLAG_FLIPS) != 0;
+            const bool flipT = (sprite.imageFlags & OBJ_FLAG_FLIPT) != 0;
+            int32_t dsdx = int32_t(std::min<int64_t>(stepS, 0x7FFF));
+            int32_t dtdy = int32_t(std::min<int64_t>(stepT, 0x7FFF));
+
+            // Mirrored rectangles start at the last texel and walk backwards,
+            // like a hand-written mirrored G_TEXRECT.
+            int32_t uls = flipS ? (shrink + texW - 32) : shrink;
+            int32_t ult = flipT ? (shrink + texH - 32) : shrink;
+            if (flipS) {
+                dsdx = -dsdx;
+            }
+
+            if (flipT) {
+                dtdy = -dtdy;
+            }
+
+            // Per-pixel texel step used for clipping (copy mode always 1:1).
+            int32_t clipDsdx = dsdx;
+            int32_t clipDtdy = dtdy;
+            if (copyMode) {
+                // Copy mode: 4 texels per clock, inclusive lower-right, no scaling.
+                clipDsdx = flipS ? -1024 : 1024;
+                clipDtdy = flipT ? -1024 : 1024;
+                dsdx = clipDsdx * 4;
+                dtdy = clipDtdy;
+                lrx -= 4;
+                lry -= 4;
+            }
+            else if (renderMode & OBJRM_BILERP) {
+                // Bilinear filtering samples between texel centres. Move the start
+                // so pixel centres line up with the scaled texel centres: the offset
+                // is (step - 1) / 2 texels in the walking direction (zero at 1:1).
+                auto centreCorrection = [](int32_t step) {
+                    const int32_t mag = std::abs(step);
+                    const int32_t c = (mag - 1024) / 64;
+                    return (step < 0) ? -c : c;
+                };
+
+                uls += centreCorrection(dsdx);
+                ult += centreCorrection(dtdy);
+
+                // 1/4 pixel movement: snap the rectangle to a whole pixel and
+                // shift the texture by the remaining fraction instead.
+                const int32_t fracX = ulx & 3;
+                const int32_t fracY = uly & 3;
+                ulx -= fracX;
+                uly -= fracY;
+                uls -= floorDiv(int64_t(fracX) * dsdx, 128);
+                ult -= floorDiv(int64_t(fracY) * dtdy, 128);
+            }
+
+            // Automatic clipping against the scissor box's upper-left corner. The
+            // RDP rectangle coordinates are unsigned, so negative positions must be
+            // clipped here with the texture start moved accordingly.
+            if (ulx < scissor.ulx) {
+                uls += floorDiv(int64_t(scissor.ulx - ulx) * clipDsdx, 128);
+                ulx = scissor.ulx;
+            }
+
+            if (uly < scissor.uly) {
+                ult += floorDiv(int64_t(scissor.uly - uly) * clipDtdy, 128);
+                uly = scissor.uly;
+            }
+
+            if ((ulx >= scissor.lrx) || (uly >= scissor.lry)) {
+                return r;
+            }
+
+            r.draw = copyMode ? ((lrx >= ulx) && (lry >= uly)) : ((lrx > ulx) && (lry > uly));
+            r.ulx = ulx;
+            r.uly = uly;
+            r.lrx = lrx;
+            r.lry = lry;
+            r.uls = uls;
+            r.ult = ult;
+            r.dsdx = dsdx;
+            r.dtdy = dtdy;
+            return r;
+        }
+
+        bool objSprite(const Sprite &sprite, const Matrix &m, uint32_t renderMode, Quad &q) {
+            const double scaleW = std::max<int32_t>(sprite.scaleW, 1) / 1024.0;
+            const double scaleH = std::max<int32_t>(sprite.scaleH, 1) / 1024.0;
+            const double shrink = shrinkAmount(renderMode) / 32.0;
+            const double texW = sprite.imageW / 32.0 - 2.0 * shrink;
+            const double texH = sprite.imageH / 32.0 - 2.0 * shrink;
+            if ((texW <= 0.0) || (texH <= 0.0)) {
+                return false;
+            }
+
+            double w = texW / scaleW;
+            double h = texH / scaleH;
+            double s0 = shrink, s1 = shrink + texW;
+            double t0 = shrink, t1 = shrink + texH;
+            if (renderMode & OBJRM_WIDEN) {
+                // Enlarge by 3/8 pixel in +S/+T to hide seams between sprites.
+                w += 0.375;
+                h += 0.375;
+                s1 += 0.375 * scaleW;
+                t1 += 0.375 * scaleH;
+            }
+
+            if (sprite.imageFlags & OBJ_FLAG_FLIPS) {
+                std::swap(s0, s1);
+            }
+
+            if (sprite.imageFlags & OBJ_FLAG_FLIPT) {
+                std::swap(t0, t1);
+            }
+
+            const double a = m.A / 65536.0, b = m.B / 65536.0, c = m.C / 65536.0, d = m.D / 65536.0;
+            const double tx = m.X / 4.0, ty = m.Y / 4.0;
+            const double det = a * d - b * c;
+            if (!(std::fabs(det) > 1e-12)) {
+                return false;
+            }
+
+            const double x0 = sprite.objX / 4.0, y0 = sprite.objY / 4.0;
+            const double lx[4] = { x0, x0 + w, x0, x0 + w };
+            const double ly[4] = { y0, y0, y0 + h, y0 + h };
+            const double ls[4] = { s0, s1, s0, s1 };
+            const double lt[4] = { t0, t0, t1, t1 };
+            double corrS = 0.0, corrT = 0.0;
+            if (renderMode & OBJRM_BILERP) {
+                // Screen-space texture gradients of the affine mapping.
+                const double ks = (s1 - s0) / w;
+                const double kt = (t1 - t0) / h;
+                const double dsdX = ks * d / det, dsdY = ks * -b / det;
+                const double dtdX = kt * -c / det, dtdY = kt * a / det;
+                corrS = 0.5 * (dsdX + dsdY) - 0.5;
+                corrT = 0.5 * (dtdX + dtdY) - 0.5;
+            }
+
+            for (int i = 0; i < 4; i++) {
+                q.x[i] = float(a * lx[i] + b * ly[i] + tx);
+                q.y[i] = float(c * lx[i] + d * ly[i] + ty);
+                q.s[i] = float(ls[i] + corrS);
+                q.t[i] = float(lt[i] + corrT);
+            }
+
+            return true;
+        }
+
+        void quadToTriangles(const Quad &q, float pos[24], float tc[12]) {
+            const int order[6] = { 0, 1, 2, 1, 3, 2 };
+            for (int i = 0; i < 6; i++) {
+                const int v = order[i];
+                pos[i * 4 + 0] = q.x[v];
+                pos[i * 4 + 1] = q.y[v];
+                pos[i * 4 + 2] = 0.0f;
+                pos[i * 4 + 3] = 1.0f;
+                tc[i * 2 + 0] = q.s[v];
+                tc[i * 2 + 1] = q.t[v];
+            }
+        }
+
+        SelectDlCommand decodeSelectDl(uint32_t half0W0, uint32_t half0W1, uint32_t w0, uint32_t w1) {
+            SelectDlCommand c;
+            c.sid = (half0W0 >> 16) & 0xFF;
+            c.flag = half0W1;
+            c.mask = w1;
+            c.address = ((w0 & 0xFFFF) << 16) | (half0W0 & 0xFFFF);
+            c.push = ((w0 >> 16) & 0xFF) == 0;
+            return c;
+        }
+
+        int32_t bgSliceLines(int32_t tmemSize, uint32_t tmemSliceWmax, int32_t usesBilerp, uint32_t scaleH, int16_t &imageSliceLines) {
+            // A slice wider than TMEM gives zero lines per slice. The microcode would
+            // then divide by zero (this is where GLideN64 crashed on Magical Tetris
+            // Challenge's results screen); always keep at least one line.
+            const int32_t tmemSliceLines = tmemSize / int32_t(std::max<uint32_t>(tmemSliceWmax, 1));
+            imageSliceLines = int16_t(std::max<int32_t>(tmemSliceLines - usesBilerp, 1));
+            const int64_t frameSliceLines = (int64_t(imageSliceLines) << 20) / std::max<uint32_t>(scaleH, 1);
+            return int32_t(std::clamp<int64_t>(frameSliceLines, 1, INT32_MAX));
+        }
+
+        bool selectDl(std::array<uint32_t, 4> &statuses, uint32_t sid, uint32_t flag, uint32_t mask) {
+            uint32_t &status = statuses[statusIndex(sid)];
+            if ((status & mask) == flag) {
+                return false;
+            }
+
+            status = (status & ~mask) | (flag & mask);
+            return true;
+        }
+    };
+};
