diff --git a/src/gbi/rt64_gbi_s2dex.cpp b/src/gbi/rt64_gbi_s2dex.cpp
index 4b41bfa..896334a 100644
--- a/src/gbi/rt64_gbi_s2dex.cpp
+++ b/src/gbi/rt64_gbi_s2dex.cpp
@@ -10,6 +10,7 @@
 #include "rt64_gbi_f3d.h"
 #include "rt64_gbi_f3dex.h"
 #include "rt64_gbi_rdp.h"
+#include "rt64_s2dex_obj.h"
 
 //#define LOG_BGRECT_METHODS
 //#define LOG_LOADTXTR_METHODS
@@ -23,7 +24,8 @@ namespace RT64 {
         void moveWord(State *state, DisplayList **dl) {
             switch ((*dl)->p0(0, 8)) {
             case G_MW_GENSTAT:
-                assert(false);
+                // gSPSetStatus(sid, value): offset field holds the sid byte offset.
+                setStatus(state, (*dl)->p0(8, 16), (*dl)->w1);
                 break;
             default:
                 GBI_F3D::moveWord(state, dl);
@@ -32,15 +34,38 @@ namespace RT64 {
         }
 
         void rdpHalf0(State *state, DisplayList **dl) {
+            // The microcode just latches this command's words. G_SELECT_DL (gsSPSelectDL /
+            // gsSPSelectBranchDL) consumes them as the low address half, sid and flag.
+            state->rsp->S2D.selectDlHalf0W0 = (*dl)->w0;
+            state->rsp->S2D.selectDlHalf0W1 = (*dl)->w1;
+
             uint8_t nextCode = (*dl + 1)->w0 >> 24;
-            if (nextCode == S2DEX_G_SELECT_DL) {
-                assert(false);
-            }
-            else if (nextCode == F3D_G_RDPHALF_1) {
+            if (nextCode == F3D_G_RDPHALF_1) {
                 GBI_RDP::texrect(state, dl);
             }
         }
 
+        void setStatus(State *state, uint32_t sid, uint32_t value) {
+            state->rsp->S2D.statuses[S2DEXObj::statusIndex(sid)] = value;
+        }
+
+        void selectDl(State *state, DisplayList **dl) {
+            // RDPHALF_0: w0 = cmd | sid << 16 | (addr & 0xFFFF), w1 = flag
+            // SELECT_DL: w0 = cmd | push << 16 | (addr >> 16),   w1 = mask
+            RSP *rsp = state->rsp.get();
+            const S2DEXObj::SelectDlCommand c = S2DEXObj::decodeSelectDl(rsp->S2D.selectDlHalf0W0, rsp->S2D.selectDlHalf0W1, (*dl)->w0, (*dl)->w1);
+            if (!S2DEXObj::selectDl(rsp->S2D.statuses, c.sid, c.flag, c.mask)) {
+                return;
+            }
+
+            if (c.push) {
+                state->pushReturnAddress(*dl);
+            }
+
+            const uint32_t rdramAddress = rsp->fromSegmentedMasked(c.address);
+            *dl = reinterpret_cast<DisplayList *>(state->fromRDRAM(rdramAddress)) - 1;
+        }
+
         void bg1CycTMEMLoadTile(RDP &rdp, const uObjScaleBg_t &scaleBg, uint32_t imagePtr, uint16_t imageSrcWsize, int16_t loadLines, int16_t tmemSH) {
             // TODO: Does it make sense that when using 32-bit images, the lrt is 0?
             const bool is32Bits = (scaleBg.imageSiz == G_IM_SIZ_32b);
@@ -198,6 +223,12 @@ namespace RT64 {
             int16_t frameRemain = frameH >> 2;
             int16_t imageSrcW = scaleBg.imageW << 3;
             int16_t imageSrcH = scaleBg.imageH << 3;
+
+            // Guard against degenerate images: the wrap loops below would never
+            // terminate and the slice math would divide by zero.
+            if ((imageSrcW <= 0) || (imageSrcH <= 0)) {
+                return;
+            }
             
             // Find the corresponding range in the image for the frame.
             // The image size needs to be extended when using bilerp.
@@ -255,7 +286,7 @@ namespace RT64 {
             // We limit the amount of TMEM that can be used to half for CI images since the upper region
             // needs to be used for the palette.
             int16_t tmemSize = (scaleBg.imageFmt == G_IM_FMT_CI) ? 256 : 512;
-            int16_t tmemShift = (0x200 >> scaleBg.imageSiz);
+            int16_t tmemShift = (0x200 >> (scaleBg.imageSiz & 0x3));
             int16_t tmemMask = (tmemShift - 1);
             int32_t imageSliceWmax;
             if (scaleBg.imageSiz == G_IM_SIZ_32b) {
@@ -269,9 +300,10 @@ namespace RT64 {
 
             // Get the amount of lines that can be loaded into TMEM at once.
             uint16_t tmemSliceWmax = (imageSliceWmax + tmemMask) / tmemShift + 1;
-            int16_t tmemSliceLines = tmemSize / tmemSliceWmax;
-            int16_t imageSliceLines = tmemSliceLines - usesBilerp;
-            int32_t frameSliceLines = (imageSliceLines << 20) / scaleH;
+            // Divide-by-zero guard (see S2DEXObj::bgSliceLines): a slice wider than TMEM
+            // yields zero lines per slice, which would make frameSliceLines zero below.
+            int16_t imageSliceLines;
+            int32_t frameSliceLines = S2DEXObj::bgSliceLines(tmemSize, tmemSliceWmax, usesBilerp, scaleH, imageSliceLines);
 
             // Figure out which line to start with from the image coordinates.
             int32_t imageLYoffset = (int32_t(imageY0) - imageYorig) << 5;
@@ -447,8 +479,16 @@ namespace RT64 {
             }
 
             const uint32_t Division = (bg.imageFmt == G_IM_FMT_CI) ? 2 : 1;
-            const uint16_t bgRectCount = bg.imageH / (bg.tmemH / Division); // TODO: Check for remaining pixels for the last Texrect.
-            bgRectLrt = (bg.tmemH / Division) - lrSubstract;
+            const uint16_t sliceH = uint16_t(bg.tmemH / Division);
+
+            // Divide-by-zero guard: a TMEM height below one line can't be drawn.
+            if (sliceH < lrSubstract) {
+                state->endSpriteCommand();
+                return;
+            }
+
+            const uint16_t bgRectCount = bg.imageH / sliceH; // TODO: Check for remaining pixels for the last Texrect.
+            bgRectLrt = sliceH - lrSubstract;
             rdp->setTileSize(G_TX_RENDERTILE, 0, 0, bgRectLrs, bgRectLrt);
 
             for (uint16_t r = 0; r < bgRectCount; r++) {
@@ -494,12 +534,12 @@ namespace RT64 {
             uint32_t mask = obj->mask;
             uint32_t flag = obj->flag;
             // Get the status for the given id.
-            uint32_t status = state->rsp->S2D.statuses[sid / 4];
+            uint32_t status = state->rsp->S2D.statuses[S2DEXObj::statusIndex(sid)];
 
             // Skip the load if the masked status is equal to the provided flag.
             if ((status & mask) != flag) {
                 // Update the status for the given id.
-                state->rsp->S2D.statuses[sid / 4] = (status & ~mask) | (flag & mask);
+                state->rsp->S2D.statuses[S2DEXObj::statusIndex(sid)] = (status & ~mask) | (flag & mask);
                 state->rsp->S2D.data_02AE = -127;
 
                 if (r1 == -127) {
@@ -546,6 +586,71 @@ namespace RT64 {
             }
         }
 
+        static void setupSpriteTile(State *state, const S2DEXObj::Sprite &sprite) {
+            const S2DEXObj::TileParams t = S2DEXObj::spriteTile(sprite, state->rsp->objRenderMode);
+            state->rdp->setTile(G_TX_RENDERTILE, t.fmt, t.siz, t.line, t.tmem, t.palette, t.cmt, t.cms, G_TX_NOMASK, G_TX_NOMASK, G_TX_NOLOD, G_TX_NOLOD);
+            state->rdp->setTileSize(G_TX_RENDERTILE, t.uls, t.ult, t.lrs, t.lrt);
+        }
+
+        static int16_t clampS16(int32_t v) {
+            return int16_t(std::clamp(v, int32_t(INT16_MIN), int32_t(INT16_MAX)));
+        }
+
+        static void doObjRectangle(State *state, const S2DEXObj::Sprite &sprite, bool useMatrix) {
+            RDP *rdp = state->rdp.get();
+            RSP *rsp = state->rsp.get();
+            setupSpriteTile(state, sprite);
+
+            const FixedRect &scissorRect = rdp->scissorRectStack[rdp->scissorStackSize - 1];
+            const S2DEXObj::Scissor scissor = { scissorRect.ulx, scissorRect.uly, scissorRect.lrx, scissorRect.lry };
+            const bool copyMode = (rdp->otherMode.cycleType() == G_CYC_COPY);
+            const S2DEXObj::Matrix matrix = S2DEXObj::decodeMatrix(rsp->S2D.objMtx);
+            const S2DEXObj::TexRect r = S2DEXObj::objRectangle(sprite, rsp->objRenderMode, copyMode, scissor, useMatrix ? &matrix : nullptr);
+            if (r.draw) {
+                rdp->drawTexRect(r.ulx, r.uly, r.lrx, r.lry, G_TX_RENDERTILE, clampS16(r.uls), clampS16(r.ult), clampS16(r.dsdx), clampS16(r.dtdy), false);
+            }
+        }
+
+        static void doObjSprite(State *state, const S2DEXObj::Sprite &sprite) {
+            RSP *rsp = state->rsp.get();
+            setupSpriteTile(state, sprite);
+
+            S2DEXObj::Quad quad;
+            const S2DEXObj::Matrix matrix = S2DEXObj::decodeMatrix(rsp->S2D.objMtx);
+            if (!S2DEXObj::objSprite(sprite, matrix, rsp->objRenderMode, quad)) {
+                return;
+            }
+
+            float pos[24];
+            float tc[12];
+            float col[24] = {};
+            S2DEXObj::quadToTriangles(quad, pos, tc);
+            state->rdp->drawTris(2, pos, tc, col, G_TX_RENDERTILE, 0);
+        }
+
+        static S2DEXObj::Sprite readSprite(State *state, uint32_t segmentedAddress) {
+            readS2DStruct(state, segmentedAddress, S2DEXObj::OBJ_SPRITE_SIZE);
+            return S2DEXObj::decodeSprite(state->rsp->S2D.struct_buffer.data(), 0);
+        }
+
+        void objRectangle(State *state, DisplayList **dl) {
+            doObjRectangle(state, readSprite(state, (*dl)->w1), false);
+        }
+
+        void objRectangleR(State *state, DisplayList **dl) {
+            doObjRectangle(state, readSprite(state, (*dl)->w1), true);
+        }
+
+        void objSprite(State *state, DisplayList **dl) {
+            doObjSprite(state, readSprite(state, (*dl)->w1));
+        }
+
+        void objMoveMem(State *state, DisplayList **dl) {
+            // gsSPObjMatrix: size 24 at offset 0. gsSPObjSubMatrix: size 8 at offset 16.
+            uint32_t rdramAddress = state->rsp->fromSegmentedMasked((*dl)->w1) & RSP_DMA_MASK;
+            S2DEXObj::moveMem(state->rsp->S2D.objMtx, state->fromRDRAM(rdramAddress), (*dl)->w0);
+        }
+
         void objLoadTxtr(State *state, DisplayList **dl) {
         #ifdef LOG_LOADTXTR_METHODS
             RT64_LOG_PRINTF("objLoadTxtr::start(0x%08X)", (*dl)->w1);
@@ -573,8 +678,7 @@ namespace RT64 {
             doLoadTxtr(state, &obj->txtr);
             
             // Execute the sprite draw
-            // TODO call doObjSprite(state, &obj->sprite) when it's implemented
-            assert(false);
+            doObjSprite(state, S2DEXObj::decodeSprite(obj->sprite, 0));
         #ifdef LOG_LOADTXTR_METHODS
             RT64_LOG_PRINTF("objLoadTxSprite::end(0x%08X)", (*dl)->w1);
         #endif
@@ -592,8 +696,7 @@ namespace RT64 {
             doLoadTxtr(state, &obj->txtr);
             
             // Execute the rect draw
-            // TODO call doObjRectangle(state, &obj->sprite) when it's implemented
-            assert(false);
+            doObjRectangle(state, S2DEXObj::decodeSprite(obj->sprite, 0), false);
         #ifdef LOG_LOADTXTR_METHODS
             RT64_LOG_PRINTF("objLoadTxRect::end(0x%08X)", (*dl)->w1);
         #endif
@@ -611,15 +714,25 @@ namespace RT64 {
             doLoadTxtr(state, &obj->txtr);
             
             // Execute the rect r draw
-            // TODO call doObjRectangleR(state, &obj->sprite) when it's implemented
-            assert(false);
+            doObjRectangle(state, S2DEXObj::decodeSprite(obj->sprite, 0), true);
         #ifdef LOG_LOADTXTR_METHODS
             RT64_LOG_PRINTF("objLoadTxRectR::end(0x%08X)", (*dl)->w1);
         #endif
         }
 
+        void resetObjectState(State *state) {
+            RSP *rsp = state->rsp.get();
+            rsp->objRenderMode = 0x0;
+            rsp->S2D.struct_buffer.fill(0);
+            rsp->S2D.statuses.fill(0);
+            rsp->S2D.data_02AE = -128;
+            S2DEXObj::resetMatrix(rsp->S2D.objMtx);
+            rsp->S2D.selectDlHalf0W0 = 0;
+            rsp->S2D.selectDlHalf0W1 = 0;
+        }
+
         void reset(State *state) {
-            state->rsp->objRenderMode = 0x0;
+            resetObjectState(state);
         }
 
         void setup(GBI *gbi) {
@@ -645,6 +758,11 @@ namespace RT64 {
             gbi->map[S2DEX_G_OBJ_LDTX_SPRITE] = &objLoadTxSprite;
             gbi->map[S2DEX_G_OBJ_LDTX_RECT] = &objLoadTxRect;
             gbi->map[S2DEX_G_OBJ_LDTX_RECT_R] = &objLoadTxRectR;
+            gbi->map[S2DEX_G_OBJ_RECTANGLE] = &objRectangle;
+            gbi->map[S2DEX_G_OBJ_RECTANGLE_R] = &objRectangleR;
+            gbi->map[S2DEX_G_OBJ_SPRITE] = &objSprite;
+            gbi->map[S2DEX_G_OBJ_MOVEMEM] = &objMoveMem;
+            gbi->map[S2DEX_G_SELECT_DL] = &selectDl;
             gbi->map[F3D_G_DL] = &GBI_F3D::runDl;
             gbi->map[F3D_G_ENDDL] = &GBI_F3D::endDl;
             gbi->map[F3D_G_MOVEWORD] = &moveWord;
@@ -659,6 +777,7 @@ namespace RT64 {
             gbi->map[G_SETTIMG] = &GBI_F3D::setTextureImage;
 
             gbi->resetFromTask = &reset;
+            gbi->resetFromLoad = &reset;
         }
     }
 };
