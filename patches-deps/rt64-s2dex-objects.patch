+++ b/src/gbi/rt64_s2dex_obj.h
@@ -0,0 +1,147 @@
+//
+// RT64
+//
+// S2DEX 1.x / S2DEX2 object (sprite) command math.
+//
+// Clean-room implementation written from the publicly documented N64 SDK
+// behaviour of the S2DEX microcode (N64 Programming Manual chapter "S2DEX
+// Microcode", the gs2dex.h structure definitions and the n64brew wiki). It is
+// deliberately independent of RT64's State/RDP classes so it can be exercised
+// by an offline unit-test harness without a GPU.
+//
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace RT64 {
+    namespace S2DEXObj {
+        // Values from the public GBI headers.
+        constexpr uint32_t OBJRM_NOTXCLAMP = 0x01;
+        constexpr uint32_t OBJRM_XLU = 0x02;
+        constexpr uint32_t OBJRM_ANTIALIAS = 0x04;
+        constexpr uint32_t OBJRM_BILERP = 0x08;
+        constexpr uint32_t OBJRM_SHRINKSIZE_1 = 0x10;
+        constexpr uint32_t OBJRM_SHRINKSIZE_2 = 0x20;
+        constexpr uint32_t OBJRM_WIDEN = 0x40;
+        constexpr uint8_t OBJ_FLAG_FLIPS = 0x01;
+        constexpr uint8_t OBJ_FLAG_FLIPT = 0x10;
+        constexpr uint8_t TX_WRAP = 0x0;
+        constexpr uint8_t TX_CLAMP = 0x2;
+        constexpr uint32_t OBJ_MTX_SIZE = 24;
+        constexpr uint32_t OBJ_SPRITE_SIZE = 24;
+
+        // RT64 keeps RDRAM (and buffers copied out of it) as host-endian 32-bit
+        // words, so logical big-endian byte i lives at physical index i ^ 3.
+        inline uint8_t readU8(const uint8_t *swapped, uint32_t offset) {
+            return swapped[offset ^ 3];
+        }
+
+        inline uint16_t readU16(const uint8_t *swapped, uint32_t offset) {
+            return uint16_t((readU8(swapped, offset) << 8) | readU8(swapped, offset + 1));
+        }
+
+        inline uint32_t readU32(const uint8_t *swapped, uint32_t offset) {
+            return (uint32_t(readU16(swapped, offset)) << 16) | readU16(swapped, offset + 2);
+        }
+
+        // uObjSprite_t (24 bytes).
+        struct Sprite {
+            int16_t objX = 0;        // s10.2
+            uint16_t scaleW = 1024;  // u5.10
+            uint16_t imageW = 0;     // u10.5
+            int16_t objY = 0;        // s10.2
+            uint16_t scaleH = 1024;  // u5.10
+            uint16_t imageH = 0;     // u10.5
+            uint16_t imageStride = 0; // 64-bit words
+            uint16_t imageAdrs = 0;  // TMEM address in 64-bit words
+            uint8_t imageFmt = 0;
+            uint8_t imageSiz = 0;
+            uint8_t imagePal = 0;
+            uint8_t imageFlags = 0;
+        };
+
+        // uObjMtx_t (24 bytes). uObjSubMtx_t is its last 8 bytes.
+        struct Matrix {
+            int32_t A = 0x10000, B = 0, C = 0, D = 0x10000; // s15.16
+            int16_t X = 0, Y = 0;                          // s10.2
+            uint16_t baseScaleX = 1024, baseScaleY = 1024; // u5.10
+        };
+
+        // Logical big-endian image of the 24-byte matrix area in DMEM.
+        using MatrixBytes = std::array<uint8_t, OBJ_MTX_SIZE>;
+
+        Sprite decodeSprite(const uint8_t *swapped, uint32_t offset = 0);
+        Matrix decodeMatrix(const MatrixBytes &bytes);
+        void resetMatrix(MatrixBytes &bytes);
+
+        // G_OBJ_MOVEMEM: w0 = cmd | (size - 1) << 16 | offset / 8. Copies the
+        // bytes into the matrix area, clamped to its 24 bytes. Returns the
+        // number of bytes copied.
+        uint32_t moveMem(MatrixBytes &bytes, const uint8_t *swappedSrc, uint32_t w0);
+
+        struct TileParams {
+            uint8_t fmt, siz, palette, cms, cmt;
+            uint16_t line, tmem;
+            uint16_t uls, ult, lrs, lrt; // 10.2
+        };
+
+        // Render tile description for a sprite already loaded into TMEM.
+        TileParams spriteTile(const Sprite &sprite, uint32_t renderMode);
+
+        struct Scissor {
+            int32_t ulx, uly, lrx, lry; // 10.2
+        };
+
+        // Parameters for an RDP texture rectangle.
+        struct TexRect {
+            bool draw = false;
+            int32_t ulx = 0, uly = 0, lrx = 0, lry = 0; // 10.2 screen coordinates
+            int32_t uls = 0, ult = 0;                   // s10.5
+            int32_t dsdx = 0, dtdy = 0;                 // s5.10
+        };
+
+        // G_OBJ_RECTANGLE (subMatrix == nullptr) and G_OBJ_RECTANGLE_R (the
+        // X/Y/BaseScale part of the current matrix).
+        TexRect objRectangle(const Sprite &sprite, uint32_t renderMode, bool copyMode, const Scissor &scissor, const Matrix *subMatrix);
+
+        // Four corners of a G_OBJ_SPRITE quad: 0 = UL, 1 = UR, 2 = LL, 3 = LR
+        // (in the sprite's local orientation). Positions are screen pixels and
+        // texture coordinates are texels.
+        struct Quad {
+            float x[4], y[4], s[4], t[4];
+        };
+
+        // Returns false (nothing to draw) for a degenerate sprite.
+        bool objSprite(const Sprite &sprite, const Matrix &matrix, uint32_t renderMode, Quad &quad);
+
+        // Expands a quad into two triangles in the layout RDP::drawTris expects:
+        // pos = 6 * {x, y, z, w}, tc = 6 * {s, t}.
+        void quadToTriangles(const Quad &quad, float pos[24], float tc[12]);
+
+        // gsSPSelectDL / gsSPSelectBranchDL status logic. Returns true when the
+        // display list must be executed, updating the status word.
+        bool selectDl(std::array<uint32_t, 4> &statuses, uint32_t sid, uint32_t flag, uint32_t mask);
+
+        // Fields of a gsSPSelectDL / gsSPSelectBranchDL pair:
+        //   G_RDPHALF_0: w0 = cmd | sid << 16 | (addr & 0xFFFF), w1 = flag
+        //   G_SELECT_DL: w0 = cmd | push << 16 | (addr >> 16),   w1 = mask
+        struct SelectDlCommand {
+            uint32_t sid, flag, mask, address;
+            bool push; // G_DL_PUSH (0) calls, G_DL_NOPUSH (1) branches.
+        };
+
+        SelectDlCommand decodeSelectDl(uint32_t half0W0, uint32_t half0W1, uint32_t w0, uint32_t w1);
+
+        // BG_1CYC slice sizing with divide-by-zero protection. Returns the number
+        // of frame lines per slice (s.10, always >= 1) and writes the image lines
+        // per slice (always >= 1).
+        int32_t bgSliceLines(int32_t tmemSize, uint32_t tmemSliceWmax, int32_t usesBilerp, uint32_t scaleH, int16_t &imageSliceLines);
+
+        // Index into the status array for an sid byte offset (0, 4, 8, 12).
+        inline uint32_t statusIndex(uint32_t sid) {
+            return (sid >> 2) & 0x3;
+        }
+    };
+};
