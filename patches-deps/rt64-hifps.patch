+//
+// RT64 high frame rate output for 2D games: C API.
+// SPDX-License-Identifier: MIT
+//
+
+#include "rt64_hifps_api.h"
+
+#include "hle/rt64_application.h"
+
+namespace {
+    RT64::SharedQueueResources *getShared(void *app) {
+        return (app != nullptr) ? static_cast<RT64::Application *>(app)->sharedQueueResources.get() : nullptr;
+    }
+
+    template<typename F>
+    void editSettings(void *app, F f) {
+        if (RT64::SharedQueueResources *s = getShared(app)) {
+            RT64::Interp2D::Settings settings = s->interp2D.getSettings();
+            f(settings);
+            s->interp2D.setSettings(settings);
+        }
+    }
+}
+
+extern "C" {
+    int rt64_hifps_supported(void) {
+        return 1;
+    }
+
+    void rt64_hifps_set_interpolation(void *app, int enabled) {
+        editSettings(app, [&](RT64::Interp2D::Settings &s) { s.enabled = (enabled != 0); });
+    }
+
+    int rt64_hifps_get_interpolation(void *app) {
+        RT64::SharedQueueResources *s = getShared(app);
+        return ((s != nullptr) && s->interp2D.getSettings().enabled) ? 1 : 0;
+    }
+
+    void rt64_hifps_set_teleport_distance(void *app, float pixels) {
+        editSettings(app, [&](RT64::Interp2D::Settings &s) { s.teleportDistance = (pixels > 0.0f) ? pixels : 0.0f; });
+    }
+
+    void rt64_hifps_set_grid_snap(void *app, int enabled) {
+        editSettings(app, [&](RT64::Interp2D::Settings &s) { s.gridSnap = (enabled != 0); });
+    }
+
+    void rt64_hifps_set_allow_above_display(void *app, int allow) {
+        if (RT64::SharedQueueResources *s = getShared(app)) s->setAllowRateAboveDisplay(allow != 0);
+    }
+
+    void rt64_hifps_tag(void *app, unsigned int rdram_address, unsigned int id, int mode) {
+        if (RT64::SharedQueueResources *s = getShared(app)) {
+            RT64::Interp2D::Mode m = RT64::Interp2D::Mode::Auto;
+            if (mode == RT64_HIFPS_MODE_SMOOTH) m = RT64::Interp2D::Mode::Smooth;
+            else if (mode == RT64_HIFPS_MODE_SNAP) m = RT64::Interp2D::Mode::Snap;
+            s->interp2D.setTag(rdram_address & 0x00FFFFF8U, id, m);
+        }
+    }
+
+    void rt64_hifps_clear_tags(void *app) {
+        if (RT64::SharedQueueResources *s = getShared(app)) s->interp2D.clearTags();
+    }
+
+    void rt64_hifps_get_stats(void *app, rt64_hifps_stats *stats) {
+        if (stats == nullptr) return;
+        *stats = rt64_hifps_stats{};
+        if (RT64::SharedQueueResources *s = getShared(app)) {
+            const RT64::Interp2D::Stats st = s->interp2D.getStats();
+            stats->frames = st.frames;
+            stats->calls = st.calls;
+            stats->matched = st.matched;
+            stats->moving = st.moving;
+            stats->snapped_grid = st.snappedGrid;
+            stats->snapped_teleport = st.snappedTeleport;
+            stats->snapped_tag = st.snappedTag;
+        }
+    }
+}
diff --git a/src/render/rt64_hifps_api.h b/src/render/rt64_hifps_api.h
new file mode 100644
index 0000000..f21daea
--- /dev/null
+++ b/src/render/rt64_hifps_api.h
@@ -0,0 +1,71 @@
+/*
+ * RT64 high frame rate output for 2D games: C API.
+ * SPDX-License-Identifier: MIT
+ *
+ * `app` is the RT64::Application* the game created. Safe to call from any thread while rendering.
+ *
+ * RT64 renders extra frames between game frames when the refresh rate target is above the game's VI rate.
+ * For 2D draws (texture rectangles, S2DEX objects/sprites) it matches calls across frames and moves them to
+ * their in-between position. These calls tune that matching:
+ *
+ *   rt64_hifps_set_interpolation(app, 1);             // 0 = repeat frames (extra frames are copies)
+ *   rt64_hifps_set_allow_above_display(app, 1);       // Manual targets above the monitor rate: vsync off
+ *   rt64_hifps_tag(app, sprite_struct_rdram_addr, object_id, RT64_HIFPS_MODE_SMOOTH);
+ */
+
+#ifndef RT64_HIFPS_API_H
+#define RT64_HIFPS_API_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if defined(_WIN32)
+#   define RT64_HIFPS_API
+#else
+#   define RT64_HIFPS_API __attribute__((visibility("default")))
+#endif
+
+#define RT64_HIFPS_MODE_AUTO 0   /* heuristics: grid steps and teleports snap */
+#define RT64_HIFPS_MODE_SMOOTH 1 /* always interpolate when matched (teleports still snap) */
+#define RT64_HIFPS_MODE_SNAP 2   /* never interpolate */
+
+typedef struct rt64_hifps_stats {
+    unsigned long long frames;           /* game frames matched */
+    unsigned long long calls;            /* 2D calls seen */
+    unsigned long long matched;          /* calls matched to the previous frame */
+    unsigned long long moving;           /* matched calls that are interpolated */
+    unsigned long long snapped_grid;     /* moves snapped as grid steps */
+    unsigned long long snapped_teleport; /* moves snapped as teleports */
+    unsigned long long snapped_tag;      /* moves snapped because of a SNAP tag */
+} rt64_hifps_stats;
+
+/* 1 if this RT64 build interpolates 2D draws. */
+RT64_HIFPS_API int rt64_hifps_supported(void);
+
+/* 1 (default) = interpolate 2D draws on extra frames, 0 = repeat the game frame. */
+RT64_HIFPS_API void rt64_hifps_set_interpolation(void *app, int enabled);
+RT64_HIFPS_API int rt64_hifps_get_interpolation(void *app);
+
+/* Moves longer than this (N64 pixels per game frame, default 40) snap instead of sliding. */
+RT64_HIFPS_API void rt64_hifps_set_teleport_distance(void *app, float pixels);
+
+/* 1 (default) = moves that are whole multiples of the object's own size snap (grid pieces). */
+RT64_HIFPS_API void rt64_hifps_set_grid_snap(void *app, int enabled);
+
+/* 1 = a Manual refresh rate may exceed the detected display rate; presentation then runs without vsync. */
+RT64_HIFPS_API void rt64_hifps_set_allow_above_display(void *app, int allow);
+
+/* Tags the draws issued from an S2DEX object struct (uObjSprite / uObjBg / uObjTxtr RDRAM address, KSEG0 or
+ * physical) or a display list command address. Draws with the same id match across frames regardless of
+ * draw order; mode overrides the heuristics. id 0 removes the tag. */
+RT64_HIFPS_API void rt64_hifps_tag(void *app, unsigned int rdram_address, unsigned int id, int mode);
+RT64_HIFPS_API void rt64_hifps_clear_tags(void *app);
+
+RT64_HIFPS_API void rt64_hifps_get_stats(void *app, rt64_hifps_stats *stats);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
-- 
