diff --git a/src/hle/rt64_interp2d.cpp b/src/hle/rt64_interp2d.cpp
new file mode 100644
index 0000000..ea70b64
--- /dev/null
+++ b/src/hle/rt64_interp2d.cpp
@@ -0,0 +1,390 @@
+//
+// RT64 2D frame interpolation. See rt64_interp2d.h.
+// SPDX-License-Identifier: MIT
+//
+
+#include "rt64_interp2d.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <unordered_map>
+
+#include "rt64_game_frame.h"
+#include "rt64_workload_queue.h"
+
+namespace RT64 {
+    void Interp2D::setTag(uint32_t rdramAddress, uint32_t id, Mode mode) {
+        std::scoped_lock<std::mutex> lock(tagMutex);
+        if (id == 0) {
+            tags.erase(rdramAddress);
+        }
+        else {
+            tags[rdramAddress] = { id, mode };
+        }
+    }
+
+    void Interp2D::clearTags() {
+        std::scoped_lock<std::mutex> lock(tagMutex);
+        tags.clear();
+    }
+
+    bool Interp2D::findTag(uint32_t rdramAddress, Tag &tag) {
+        std::scoped_lock<std::mutex> lock(tagMutex);
+        if (tags.empty()) {
+            return false;
+        }
+
+        auto it = tags.find(rdramAddress);
+        if (it == tags.end()) {
+            return false;
+        }
+
+        tag = it->second;
+        return true;
+    }
+
+    Interp2D::Settings Interp2D::getSettings() {
+        std::scoped_lock<std::mutex> lock(settingsMutex);
+        return settings;
+    }
+
+    void Interp2D::setSettings(const Settings &newSettings) {
+        std::scoped_lock<std::mutex> lock(settingsMutex);
+        settings = newSettings;
+    }
+
+    Interp2D::Stats Interp2D::getStats() {
+        std::scoped_lock<std::mutex> lock(statsMutex);
+        return stats;
+    }
+
+    void Interp2D::clearResults() {
+        for (auto &r : results) {
+            r.clear();
+        }
+    }
+
+    const Interp2D::CallResult *Interp2D::result(uint32_t workloadIndex, uint32_t callIndex) const {
+        if (workloadIndex >= results.size()) {
+            return nullptr;
+        }
+
+        const std::vector<CallResult> &r = results[workloadIndex];
+        if ((callIndex >= r.size()) || !r[callIndex].mapped) {
+            return nullptr;
+        }
+
+        return &r[callIndex];
+    }
+
+    namespace {
+        struct Item {
+            uint32_t callIndex;
+            bool rect;
+            float x, y, w, h;
+            FixedRect fixedRect;
+            uint64_t texHash;
+            uint32_t source;
+            int64_t sourceRel;
+            uint32_t tag;
+            Interp2D::Mode mode;
+            int32_t match = -1;
+        };
+
+        uint64_t mix(uint64_t h, uint64_t v) {
+            h ^= v + 0x9E3779B97F4A7C15ULL + (h << 6) + (h >> 2);
+            return h;
+        }
+
+        void collectItems(const Workload &workload, uint32_t f, std::vector<Item> &items) {
+            items.clear();
+            const FramebufferPair &fbPair = workload.fbPairs[f];
+            const DrawData &drawData = workload.drawData;
+            for (uint32_t p = 0; p < fbPair.projectionCount; p++) {
+                const Projection &proj = fbPair.projections[p];
+                const bool rect = (proj.type == Projection::Type::Rectangle);
+                if (!rect && (proj.type != Projection::Type::Triangle)) {
+                    continue;
+                }
+
+                for (uint32_t c = 0; c < proj.gameCallCount; c++) {
+                    const GameCall &call = proj.gameCalls[c];
+                    const DrawCall &d = call.callDesc;
+                    if (d.triangleCount == 0) {
+                        continue;
+                    }
+
+                    // Fill rects (COPY/FILL backgrounds) never move.
+                    if (d.otherMode.cycleType() == G_CYC_FILL) {
+                        continue;
+                    }
+
+                    Item it;
+                    it.callIndex = d.callIndex;
+                    it.rect = rect;
+                    if (rect) {
+                        it.fixedRect = d.rect;
+                        it.x = d.rect.ulx / 4.0f;
+                        it.y = d.rect.uly / 4.0f;
+                        it.w = (d.rect.lrx - d.rect.ulx) / 4.0f;
+                        it.h = (d.rect.lry - d.rect.uly) / 4.0f;
+                    }
+                    else {
+                        const size_t start = size_t(call.meshDesc.rawVertexStart) * 4;
+                        const size_t end = start + size_t(d.triangleCount) * 3 * 4;
+                        if (end > drawData.triPosFloats.size()) {
+                            continue;
+                        }
+
+                        float minX = 1e9f, minY = 1e9f, maxX = -1e9f, maxY = -1e9f;
+                        for (size_t v = start; v < end; v += 4) {
+                            minX = std::min(minX, drawData.triPosFloats[v + 0]);
+                            minY = std::min(minY, drawData.triPosFloats[v + 1]);
+                            maxX = std::max(maxX, drawData.triPosFloats[v + 0]);
+                            maxY = std::max(maxY, drawData.triPosFloats[v + 1]);
+                        }
+
+                        it.x = minX;
+                        it.y = minY;
+                        it.w = maxX - minX;
+                        it.h = maxY - minY;
+                    }
+
+                    it.texHash = 0;
+                    if (d.textureOn && (d.tileCount > 0) && (d.tileIndex < drawData.callTiles.size())) {
+                        const DrawCallTile &t = drawData.callTiles[d.tileIndex];
+                        it.texHash = mix(t.tmemHashOrID, t.tlut);
+                    }
+
+                    it.source = d.interpSource;
+                    it.sourceRel = int64_t(d.interpSource) - int64_t(fbPair.displayListAddress);
+                    it.tag = d.interpTag;
+                    it.mode = Interp2D::Mode(d.interpMode);
+                    items.emplace_back(it);
+                }
+            }
+        }
+
+        // Pairs unmatched items that share a key. Equal counts pair in draw order, otherwise nearest first.
+        template<typename KeyFn>
+        void pairByKey(std::vector<Item> &cur, std::vector<Item> &prev, KeyFn key, bool requireNear, float nearDistance) {
+            std::unordered_map<uint64_t, std::vector<uint32_t>> curBuckets, prevBuckets;
+            for (uint32_t i = 0; i < cur.size(); i++) {
+                uint64_t k;
+                if ((cur[i].match < 0) && key(cur[i], k)) {
+                    curBuckets[k].push_back(i);
+                }
+            }
+
+            if (curBuckets.empty()) {
+                return;
+            }
+
+            for (uint32_t i = 0; i < prev.size(); i++) {
+                uint64_t k;
+                if ((prev[i].match < 0) && key(prev[i], k) && (curBuckets.find(k) != curBuckets.end())) {
+                    prevBuckets[k].push_back(i);
+                }
+            }
+
+            for (auto &bucket : curBuckets) {
+                auto pit = prevBuckets.find(bucket.first);
+                if (pit == prevBuckets.end()) {
+                    continue;
+                }
+
+                std::vector<uint32_t> &cs = bucket.second;
+                std::vector<uint32_t> &ps = pit->second;
+                if (cs.size() == ps.size()) {
+                    for (size_t j = 0; j < cs.size(); j++) {
+                        Item &c = cur[cs[j]];
+                        Item &p = prev[ps[j]];
+                        if (requireNear && (std::hypot(c.x - p.x, c.y - p.y) > nearDistance)) {
+                            continue;
+                        }
+
+                        c.match = int32_t(ps[j]);
+                        p.match = int32_t(cs[j]);
+                    }
+                }
+                else {
+                    // Greedy nearest pairs.
+                    struct Candidate { float d; uint32_t c, p; };
+                    std::vector<Candidate> candidates;
+                    candidates.reserve(cs.size() * ps.size());
+                    for (uint32_t ci : cs) {
+                        for (uint32_t pi : ps) {
+                            const float d = std::hypot(cur[ci].x - prev[pi].x, cur[ci].y - prev[pi].y);
+                            if (!requireNear || (d <= nearDistance)) {
+                                candidates.push_back({ d, ci, pi });
+                            }
+                        }
+                    }
+
+                    std::sort(candidates.begin(), candidates.end(), [](const Candidate &a, const Candidate &b) { return a.d < b.d; });
+                    for (const Candidate &cand : candidates) {
+                        if ((cur[cand.c].match < 0) && (prev[cand.p].match < 0)) {
+                            cur[cand.c].match = int32_t(cand.p);
+                            prev[cand.p].match = int32_t(cand.c);
+                        }
+                    }
+                }
+            }
+        }
+
+        bool isGridStep(float delta, float size, int minGrid) {
+            const float a = std::fabs(delta);
+            if (a < 0.01f) {
+                return true; // No movement on this axis is compatible with a grid step on the other one.
+            }
+
+            if (size < float(minGrid)) {
+                return false;
+            }
+
+            const float steps = a / size;
+            return (steps >= 0.99f) && (std::fabs(steps - std::round(steps)) < 0.02f);
+        }
+    }
+
+    void Interp2D::match(WorkloadQueue &workloadQueue, const GameFrame &curFrame, const GameFrame &prevFrame) {
+        const Settings s = getSettings();
+        if (results.size() < workloadQueue.workloads.size()) {
+            results.resize(workloadQueue.workloads.size());
+        }
+
+        for (uint32_t w : curFrame.workloads) {
+            results[w].clear();
+        }
+
+        if (!s.enabled || prevFrame.workloads.empty()) {
+            return;
+        }
+
+        if (!dumpChecked) {
+            dumpChecked = true;
+            const char *dumpPath = getenv("RT64_HIFPS_DUMP");
+            if ((dumpPath != nullptr) && (dumpPath[0] != '\0')) {
+                dumpFile = fopen(dumpPath, "w");
+            }
+        }
+
+        const bool dumping = (dumpFile != nullptr) && (dumpFrames < 2000);
+        Stats frameStats;
+        frameStats.frames = 1;
+        std::vector<Item> curItems, prevItems;
+        const size_t workloadPairs = std::min(curFrame.workloads.size(), prevFrame.workloads.size());
+        for (size_t k = 0; k < workloadPairs; k++) {
+            const uint32_t cw = curFrame.workloads[k];
+            const uint32_t pw = prevFrame.workloads[k];
+            const Workload &curWorkload = workloadQueue.workloads[cw];
+            const Workload &prevWorkload = workloadQueue.workloads[pw];
+            std::vector<CallResult> &out = results[cw];
+            out.assign(curWorkload.gameCallCount, CallResult());
+
+            const uint32_t fbPairs = std::min(curWorkload.fbPairCount, prevWorkload.fbPairCount);
+            for (uint32_t f = 0; f < fbPairs; f++) {
+                if (curWorkload.fbPairs[f].colorImage.width != prevWorkload.fbPairs[f].colorImage.width) {
+                    continue;
+                }
+
+                collectItems(curWorkload, f, curItems);
+                collectItems(prevWorkload, f, prevItems);
+                frameStats.calls += curItems.size();
+
+                // 1. Explicit tags.
+                pairByKey(curItems, prevItems, [](const Item &it, uint64_t &k) {
+                    k = mix(1, it.tag);
+                    return it.tag != 0;
+                }, false, 0.0f);
+
+                // 2. Same source struct, same kind and size (animation frames may change the texture).
+                pairByKey(curItems, prevItems, [](const Item &it, uint64_t &k) {
+                    k = mix(mix(mix(2, it.source), it.rect), mix(uint64_t(std::lround(it.w * 4)), uint64_t(std::lround(it.h * 4))));
+                    return it.source != 0;
+                }, true, s.teleportDistance * 2.0f);
+
+                // 3. Same source offset relative to the display list (double-buffered DL memory).
+                pairByKey(curItems, prevItems, [](const Item &it, uint64_t &k) {
+                    k = mix(mix(mix(3, uint64_t(it.sourceRel)), it.rect), mix(uint64_t(std::lround(it.w * 4)), uint64_t(std::lround(it.h * 4))));
+                    return it.source != 0;
+                }, true, s.teleportDistance * 2.0f);
+
+                // 4. Same texture and size.
+                pairByKey(curItems, prevItems, [](const Item &it, uint64_t &k) {
+                    k = mix(mix(mix(4, it.texHash), it.rect), mix(uint64_t(std::lround(it.w * 4)), uint64_t(std::lround(it.h * 4))));
+                    return it.texHash != 0;
+                }, true, s.teleportDistance * 2.0f);
+
+                for (const Item &c : curItems) {
+                    const char *verdict = "new";
+                    if (c.match >= 0) {
+                        const Item &p = prevItems[c.match];
+                        frameStats.matched++;
+                        const float dx = c.x - p.x;
+                        const float dy = c.y - p.y;
+                        const float dw = c.w - p.w;
+                        const float dh = c.h - p.h;
+                        const bool moved = (std::fabs(dx) > 0.01f) || (std::fabs(dy) > 0.01f) || (std::fabs(dw) > 0.01f) || (std::fabs(dh) > 0.01f);
+                        const Mode mode = (c.tag != 0) ? c.mode : Mode::Auto;
+                        verdict = "still";
+                        if (moved) {
+                            const bool sizeJump = (std::fabs(dw) > std::max(2.0f, p.w * 0.25f)) || (std::fabs(dh) > std::max(2.0f, p.h * 0.25f));
+                            if (mode == Mode::Snap) {
+                                verdict = "snap-tag";
+                                frameStats.snappedTag++;
+                            }
+                            else if ((std::hypot(dx, dy) > s.teleportDistance) || sizeJump) {
+                                verdict = "snap-teleport";
+                                frameStats.snappedTeleport++;
+                            }
+                            else if ((mode == Mode::Auto) && s.gridSnap && (std::fabs(dw) < 0.01f) && (std::fabs(dh) < 0.01f) &&
+                                isGridStep(dx, c.w, s.minGridSize) && isGridStep(dy, c.h, s.minGridSize))
+                            {
+                                verdict = "snap-grid";
+                                frameStats.snappedGrid++;
+                            }
+                            else if (c.callIndex < out.size()) {
+                                CallResult &r = out[c.callIndex];
+                                r.mapped = true;
+                                r.rect = c.rect;
+                                r.prevRect = p.fixedRect;
+                                r.dx = dx;
+                                r.dy = dy;
+                                verdict = "lerp";
+                                frameStats.moving++;
+                            }
+                        }
+                    }
+
+                    if (dumping) {
+                        fprintf(dumpFile, "F%u w%zu f%u c%u %s pos=%.2f,%.2f size=%.2fx%.2f tex=%016llx src=%08X rel=%lld tag=%u",
+                            dumpFrames, k, f, c.callIndex, c.rect ? "rect" : "tri", c.x, c.y, c.w, c.h, (unsigned long long)c.texHash, c.source, (long long)c.sourceRel, c.tag);
+                        if (c.match >= 0) {
+                            const Item &p = prevItems[c.match];
+                            fprintf(dumpFile, " <- %.2f,%.2f %s\n", p.x, p.y, verdict);
+                        }
+                        else {
+                            fprintf(dumpFile, " %s\n", verdict);
+                        }
+                    }
+                }
+            }
+        }
+
+        if (dumping) {
+            dumpFrames++;
+            fflush(dumpFile);
+        }
+
+        std::scoped_lock<std::mutex> lock(statsMutex);
+        stats.frames += frameStats.frames;
+        stats.calls += frameStats.calls;
+        stats.matched += frameStats.matched;
+        stats.moving += frameStats.moving;
+        stats.snappedGrid += frameStats.snappedGrid;
+        stats.snappedTeleport += frameStats.snappedTeleport;
+        stats.snappedTag += frameStats.snappedTag;
+    }
+};
diff --git a/src/hle/rt64_interp2d.h b/src/hle/rt64_interp2d.h
new file mode 100644
index 0000000..bc74f9b
--- /dev/null
+++ b/src/hle/rt64_interp2d.h
@@ -0,0 +1,97 @@
+//
+// RT64 2D frame interpolation (S2DEX objects, texture rectangles, raw 2D triangles).
+// SPDX-License-Identifier: MIT
+//
+// RT64 interpolates 3D draws by matching matrices across frames. 2D games draw everything as rectangles or
+// screen-space triangles, so there is nothing to match by default and extra frames simply repeat. This module
+// matches 2D draw calls of consecutive game frames and moves (translates and, for rectangles, resizes) each
+// matched call to its position at the in-between time:
+//   1. Explicit tags: the game (via rt64_interp_tag) maps the RDRAM address of a sprite struct to an object id.
+//   2. Source: the RDRAM address of the S2DEX object struct (or the DL command) that issued the draw.
+//   3. Texture + size: the same image drawn with the same size, in draw order / nearest position.
+// Moves that look like grid steps (a multiple of the object's own size) or teleports (longer than the teleport
+// distance) snap instead of sliding.
+//
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "common/rt64_common.h"
+
+namespace RT64 {
+    struct GameFrame;
+    struct WorkloadQueue;
+
+    struct Interp2D {
+        enum class Mode : uint8_t {
+            Auto = 0,   // Heuristics decide (grid-step and teleport snapping).
+            Smooth = 1, // Always interpolate when matched (still snaps on teleports).
+            Snap = 2,   // Never interpolate.
+        };
+
+        struct Settings {
+            bool enabled = true;           // false = frame repeat (extra frames are identical copies).
+            float teleportDistance = 40.0f; // N64 pixels per game frame; longer moves snap.
+            bool gridSnap = true;           // Snap moves that are whole multiples of the object's size.
+            int minGridSize = 4;            // Objects smaller than this never grid-snap.
+        };
+
+        struct Tag {
+            uint32_t id = 0;
+            Mode mode = Mode::Auto;
+        };
+
+        struct CallResult {
+            bool mapped = false;
+            bool rect = false;
+            FixedRect prevRect;       // Rectangles: the matched call's rect in the previous frame.
