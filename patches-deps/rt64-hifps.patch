+    bool Interp2D::findTagRange(uint32_t rdramAddress, Tag &tag) {
+        std::scoped_lock<std::mutex> lock(tagMutex);
+        if (tagRanges.empty()) {
+            return false;
+        }
+
+        // Walk back from the last range starting at or before the address; nested ranges sit right before it.
+        auto it = tagRanges.upper_bound(rdramAddress);
+        for (int steps = 0; (it != tagRanges.begin()) && (steps < 16); steps++) {
+            --it;
+            const TagRange &r = it->second;
+            if (rdramAddress < r.end) {
+                tag = { r.id, r.mode };
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    void Interp2D::setTagRanges(uint32_t clearStart, uint32_t clearEnd, const TagRange *ranges, size_t count) {
+        std::scoped_lock<std::mutex> lock(tagMutex);
+        tagRanges.erase(tagRanges.lower_bound(clearStart), tagRanges.lower_bound(clearEnd));
+        for (size_t i = 0; i < count; i++) {
+            if ((ranges[i].end > ranges[i].start) && (ranges[i].id != 0)) {
+                tagRanges[ranges[i].start] = ranges[i];
+            }
+        }
+    }
+
+    void Interp2D::clearTagRanges() {
+        std::scoped_lock<std::mutex> lock(tagMutex);
+        tagRanges.clear();
+    }
