 #include "rt64_workload_queue.h"
 
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+
 namespace RT64 {
+    // [magical-tetris hifps] Debug instrumentation for high frame rate output (present thread only).
+    //   RT64_HIFPS_LOG=1                 once per second: presents, interpolated presents, rates, vsync, 2D matches.
+    //   RT64_HIFPS_CAPTURE=<dir>         when <dir>/trigger exists, read back the next N presented game images
+    //                                    (including interpolated ones) to <dir>/cap_NNNN.ppm and delete the trigger.
+    //                                    N comes from the trigger file contents (default 12). <dir>/frames.txt
+    //                                    lists capture index, game present id, sub-frame index and sub-frame count.
+    struct HifpsDebug {
+        bool initialized = false;
+        bool logEnabled = false;
+        std::string captureDir;
+        uint32_t captureRemaining = 0;
+        uint32_t captureIndex = 0;
+        uint32_t triggerPoll = 0;
+        std::unique_ptr<RenderBuffer> readback;
+        uint64_t readbackSize = 0;
+        uint32_t readbackWidth = 0, readbackHeight = 0, readbackRowPitch = 0;
+        RenderFormat readbackFormat = RenderFormat::UNKNOWN;
+        bool readbackPending = false;
+        FILE *framesFile = nullptr;
+        std::chrono::steady_clock::time_point logStart;
+        uint64_t presents = 0, interpolatedPresents = 0, gamePresents = 0;
+        Interp2D::Stats lastStats;
+
+        void init() {
+            if (initialized) {
+                return;
+            }
+
+            initialized = true;
+            const char *log = getenv("RT64_HIFPS_LOG");
+            logEnabled = (log != nullptr) && (log[0] != '\0') && (log[0] != '0');
+            const char *dir = getenv("RT64_HIFPS_CAPTURE");
+            if (dir != nullptr) {
+                captureDir = dir;
+            }
+
+            logStart = std::chrono::steady_clock::now();
+        }
+
+        void pollTrigger() {
+            if (captureDir.empty() || (captureRemaining > 0) || ((triggerPoll++ % 30) != 0)) {
+                return;
+            }
+
+            std::error_code ec;
+            const std::filesystem::path trigger = std::filesystem::path(captureDir) / "trigger";
+            if (!std::filesystem::exists(trigger, ec)) {
+                return;
+            }
+
+            uint32_t count = 12;
+            if (FILE *f = fopen(trigger.string().c_str(), "rb")) {
+                unsigned int n = 0;
+                if ((fscanf(f, "%u", &n) == 1) && (n > 0)) {
+                    count = std::min(n, 2000U);
+                }
+
+                fclose(f);
+            }
+
+            std::filesystem::remove(trigger, ec);
+            captureRemaining = count;
+            if (framesFile == nullptr) {
+                framesFile = fopen((std::filesystem::path(captureDir) / "frames.txt").string().c_str(), "ab");
+            }
+
+            fprintf(stderr, "[hifps] capturing %u frames to %s\n", count, captureDir.c_str());
+        }
+
+        // Records the copy of the game image into the readback buffer. Returns whether a copy was recorded.
+        bool recordCopy(RenderDevice *device, RenderCommandList *commandList, RenderTexture *texture, RenderFormat format, uint32_t width, uint32_t height) {
+            if ((captureRemaining == 0) || (texture == nullptr) || (width == 0) || (height == 0)) {
+                return false;
+            }
+
+            if ((format != RenderFormat::R8G8B8A8_UNORM) && (format != RenderFormat::R16G16B16A16_UNORM)) {
+                return false;
+            }
+
+            const uint32_t pixelSize = RenderFormatSize(format);
+            const uint32_t rowPitch = ((width * pixelSize + 255) / 256) * 256;
+            const uint64_t size = uint64_t(rowPitch) * height;
+            if ((readback == nullptr) || (readbackSize < size)) {
+                readback = device->createBuffer(RenderBufferDesc::ReadbackBuffer(size));
+                readbackSize = size;
+            }
+
+            readbackWidth = width;
+            readbackHeight = height;
+            readbackRowPitch = rowPitch;
+            readbackFormat = format;
+            commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(texture, RenderTextureLayout::COPY_SOURCE));
+            commandList->copyTextureRegion(RenderTextureCopyLocation::PlacedFootprint(readback.get(), format, width, height, 1, rowPitch / pixelSize), RenderTextureCopyLocation::Subresource(texture));
+            commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(texture, RenderTextureLayout::SHADER_READ));
+            readbackPending = true;
+            return true;
+        }
+
+        // Called once the present command list has finished executing.
+        void writeCapture(uint64_t presentId, int32_t subFrame, int32_t subFrames) {
+            if (!readbackPending) {
+                return;
+            }
+
+            readbackPending = false;
+            char name[64];
+            snprintf(name, sizeof(name), "cap_%04u.ppm", captureIndex);
+            const std::string path = (std::filesystem::path(captureDir) / name).string();
+            FILE *f = fopen(path.c_str(), "wb");
+            if (f != nullptr) {
+                fprintf(f, "P6\n%u %u\n255\n", readbackWidth, readbackHeight);
+                const uint8_t *data = reinterpret_cast<const uint8_t *>(readback->map());
+                std::vector<uint8_t> row(size_t(readbackWidth) * 3);
+                const bool wide = (readbackFormat == RenderFormat::R16G16B16A16_UNORM);
+                for (uint32_t y = 0; y < readbackHeight; y++) {
+                    const uint8_t *src = data + size_t(y) * readbackRowPitch;
+                    for (uint32_t x = 0; x < readbackWidth; x++) {
+                        for (uint32_t c = 0; c < 3; c++) {
+                            row[x * 3 + c] = wide ? src[(x * 4 + c) * 2 + 1] : src[x * 4 + c];
+                        }
+                    }
+
+                    fwrite(row.data(), 1, row.size(), f);
+                }
+
+                readback->unmap();
+                fclose(f);
+            }
+
+            if (framesFile != nullptr) {
+                fprintf(framesFile, "%s present=%llu sub=%d/%d\n", name, (unsigned long long)(presentId), subFrame, subFrames);
+                fflush(framesFile);
+            }
+
+            captureIndex++;
+            captureRemaining--;
+        }
+
+        void countPresent(bool interpolated, bool firstOfGameFrame, SharedQueueResources *shared, RenderSwapChain *swapChain, uint32_t targetRate, uint32_t viOriginalRate) {
+            presents++;
+            interpolatedPresents += interpolated ? 1 : 0;
+            gamePresents += firstOfGameFrame ? 1 : 0;
+            if (!logEnabled) {
+                return;
+            }
+
+            const auto now = std::chrono::steady_clock::now();
+            const double seconds = std::chrono::duration<double>(now - logStart).count();
+            if (seconds < 1.0) {
+                return;
+            }
+
+            const Interp2D::Stats st = shared->interp2D.getStats();
+            fprintf(stderr, "[hifps] %.1f presents/s (%.1f interpolated, %.1f game frames/s) target=%u display=%u vi=%u vsync=%d | 2D calls=%llu matched=%llu moving=%llu grid=%llu teleport=%llu tag=%llu\n",
+                presents / seconds, interpolatedPresents / seconds, gamePresents / seconds, targetRate, shared->swapChainRate, viOriginalRate, swapChain->isVsyncEnabled() ? 1 : 0,
+                (unsigned long long)(st.calls - lastStats.calls), (unsigned long long)(st.matched - lastStats.matched), (unsigned long long)(st.moving - lastStats.moving),
+                (unsigned long long)(st.snappedGrid - lastStats.snappedGrid), (unsigned long long)(st.snappedTeleport - lastStats.snappedTeleport), (unsigned long long)(st.snappedTag - lastStats.snappedTag));
+            lastStats = st;
+            presents = interpolatedPresents = gamePresents = 0;
+            logStart = now;
+        }
+    };
+
+    static HifpsDebug hifpsDebug;
+
     // PresentQueue
 
     PresentQueue::PresentQueue() {
